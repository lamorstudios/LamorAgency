---
/**
 * Sales-Landingpage für das Website-Produkt.
 * Läuft eigenständig: Wer über eine Meta Ad nur wegen einer Website kommt,
 * muss nichts über die übrigen Leistungen wissen, um anfragen zu können.
 *
 * Aufbau: Hero → Trust → Problem/Lösung → Beispiele → Vorteile → Prozess →
 * Pakete → Website+Content → Referenzen → FAQ → Formular → finaler CTA.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import WebsiteHero from '@/components/sections/WebsiteHero.astro';
import Clients from '@/components/sections/Clients.astro';
import WebsiteProblem from '@/components/sections/WebsiteProblem.astro';
import WebsiteValue from '@/components/sections/WebsiteValue.astro';
import WebsiteCalculator from '@/components/sections/WebsiteCalculator.astro';
import StickyCta from '@/components/StickyCta.astro';
import WebsiteProcess from '@/components/sections/WebsiteProcess.astro';
import WebsitePricing from '@/components/sections/WebsitePricing.astro';
import WebsiteContentUsp from '@/components/sections/WebsiteContentUsp.astro';
import WebsiteLeadForm from '@/components/sections/WebsiteLeadForm.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Faq from '@/components/sections/Faq.astro';
import Media from '@/components/Media.astro';
import Words from '@/components/Words.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { websiteFaqs } from '@/data/faq';
import { websiteEntryPrice, websiteEntryMonthly, euro, websitePricing } from '@/data/website-pricing';
import { breadcrumb, faqPage, websiteServiceSchema } from '@/lib/schema';

/**
 * Leistungsumfang als Matrix statt als sechs Karten mit Absatz.
 * Drei Gruppen, je drei bis vier Stichpunkte – in drei Sekunden erfassbar.
 */
const scope = [
  {
    group: 'Website',
    icon: 'cube',
    items: ['Individuelles Design', 'Mobile zuerst gebaut', 'Responsive Umsetzung', 'Kurze Ladezeiten'],
  },
  {
    group: 'Sichtbarkeit',
    icon: 'trend',
    items: ['SEO-Grundlagen', 'Saubere technische Struktur', 'Auf Anfragen ausgelegt', 'Sichtbare Kontaktwege'],
  },
  {
    group: 'Absicherung',
    icon: 'heart',
    items: ['Impressum & Datenschutz', 'DSGVO-Basics eingebunden', 'Hosting & Updates optional', 'Content auf Wunsch inklusive'],
  },
];

const examples = [
  { label: '[WEBDESIGN] Beispiel Gastronomie', alt: 'Website-Beispiel Gastronomie', ratio: 'portrait' as const, caption: 'Gastronomie · Onepage' },
  { label: '[WEBDESIGN] Beispiel Dienstleister', alt: 'Website-Beispiel Dienstleister', ratio: 'portrait' as const, caption: 'Dienstleister · Business' },
  { label: '[WEBDESIGN] Beispiel Marke', alt: 'Website-Beispiel Markenauftritt', ratio: 'portrait' as const, caption: 'Marke · Premium' },
];

const description = `Webdesign aus ${site.address.city}: individuelle Websites ab ${euro(websiteEntryPrice)} einmalig, Betreuung optional ab ${euro(websiteEntryMonthly)} pro Monat. Inklusive Foto- und Videoproduktion aus einer Hand.`;
---
<BaseLayout
  title="Webdesign München – individuelle Websites ab 1.490 €"
  description={description}
  theme="dark"
  jsonLd={[
    breadcrumb([{ name: 'Webdesign München', path: '/webdesign-muenchen/' }]),
    websiteServiceSchema(),
    faqPage(websiteFaqs),
  ]}
>
  <WebsiteHero />
  <WebsiteValue />
  <WebsiteCalculator />
  <Clients label="Vertrauen uns" title="Marken, für die wir gearbeitet haben." compact />
  <WebsiteProblem />

  <!-- Website-Beispiele -->
  <section class="wx section" data-theme="dark" data-bg="dark" aria-labelledby="wx-title">
    <div class="container">
      <div class="wx__head">
        <p class="t-label wx__label" data-reveal="fade">Beispiele</p>
        <h2 class="t-sec wx__title" id="wx-title"><Words text="So sehen unsere Websites aus." /></h2>
      </div>
      <ul class="wx__grid swipe" role="list">
        {examples.map((ex, i) => (
          <li class="wx__item" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <Media
              media={{ type: 'placeholder', alt: ex.alt, label: ex.label }}
              ratio={ex.ratio}
              hover
              reveal
              sizes="(min-width: 900px) 32vw, 100vw"
            />
            <p class="t-label t-muted wx__caption">{ex.caption}</p>
          </li>
        ))}
      </ul>
      <p class="t-small t-muted wx__note" data-reveal="fade">
        Jedes Projekt wird individuell gestaltet – die Beispiele zeigen den Aufbau, nicht eine Vorlage.
      </p>
    </div>
  </section>

  <!-- Leistungsumfang -->
  <section class="wv wash" data-theme="light" data-bg="light" aria-labelledby="wv-title">
    <div class="container">
      <div class="wv__head">
        <p class="eyebrow wv__label" data-reveal="fade">Leistungsumfang</p>
        <h2 class="t-sec wv__title" id="wv-title"><Words text="Was drin ist." /></h2>
      </div>
      <ul class="wv__grid" role="list">
        {scope.map((g) => (
          <li class="card card--light wv__card" data-reveal>
            <div class="wv__card-head">
              <span class="itile"><Icon name={g.icon} /></span>
              <h3 class="wv__card-title">{g.group}</h3>
            </div>
            <ul class="wv__items" role="list">
              {g.items.map((i) => (
                <li class="wv__item">
                  <Icon name="check" class="wv__check" />
                  <span>{i}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <WebsiteProcess />
  <WebsitePricing />
  <WebsiteContentUsp />
  <Testimonials />

  <Faq
    id="website-faq"
    items={websiteFaqs}
    label="Häufige Fragen"
    heading="Was Kunden vor dem Start wissen wollen."
    lead="Noch eine Frage offen? Stell sie einfach direkt im Formular – wir antworten persönlich."
  />

  <WebsiteLeadForm />

  <!-- Finaler CTA -->
  <section class="wf section" data-theme="dark" data-bg="dark" aria-labelledby="wf-title">
    <div class="container wf__inner">
      <h2 class="t-hero wf__title" id="wf-title">
        <Words lines={['Bereit für eine', 'Website, die wirkt?']} />
      </h2>
      <p class="t-lead wf__lead" data-reveal style="--reveal-delay:200ms">
        {websitePricing.length} Pakete, ein klarer Preis, ein Ansprechpartner.
        Schreib uns – die Einschätzung kostet nichts.
      </p>
      <div class="wf__actions" data-reveal style="--reveal-delay:280ms">
        <a href="#anfrage" class="btn" data-magnetic>
          <span>Website anfragen</span>
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
        <a href={site.whatsapp} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
          <span>WhatsApp</span>
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
      <p class="t-label t-muted wf__meta" data-reveal="fade" style="--reveal-delay:340ms">
        <a href={`mailto:${site.email}`} class="link">{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={site.phoneHref} class="link">{site.phone}</a>
        <span aria-hidden="true">·</span>
        <span>{site.address.city}</span>
      </p>
    </div>
  </section>
  <StickyCta label="Website anfragen" />
</BaseLayout>

<style>
  /* Beispiele */
  .wx__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .wx__label { color: var(--c-accent); }
  .wx__title { max-width: 18ch; }
  /* Unter 700px waagerechte Swipe-Reihe statt drei gestapelter Hochformate. */
  @media (min-width: 700px) {
    .wx__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: var(--space-6) var(--grid-gap);
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }
  }
  .wx__caption { margin-top: var(--space-3); }
  .wx__note { margin-top: var(--space-6); max-width: 56ch; }

  /* Vorteile */
  .wv { padding-block: clamp(2.75rem, 6vw, 5.5rem); }
  .wv__head { display: grid; gap: var(--space-3); margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem); }
  .wv__label { color: var(--c-accent-text); }
  .wv__title { max-width: 18ch; }

  /* Drei Gruppen nebeneinander – auf dem Telefon zwei, damit der Umfang
     als Block lesbar bleibt statt als lange Liste. */
  .wv__grid {
    display: grid; gap: clamp(0.5rem, 1.5vw, 1.25rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .wv__card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .wv__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wv__card:last-child:nth-child(odd) { grid-column: auto; }
  }
  .wv__card {
    display: grid; gap: clamp(0.5rem, 1.4vw, 0.85rem); align-content: start;
    padding: clamp(0.85rem, 2.2vw, 1.5rem);
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .wv__card:hover { transform: translateY(-3px); } }
  .wv__card-head {
    display: flex; align-items: center; gap: clamp(0.4rem, 1.2vw, 0.7rem);
    padding-bottom: clamp(0.4rem, 1.2vw, 0.7rem);
    border-bottom: 1px solid var(--card-line);
  }
  .wv__card-title {
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    text-transform: uppercase; font-size: clamp(0.82rem, 2.2vw, 1.15rem);
    line-height: 1.05; letter-spacing: -0.03em;
  }
  .wv__items { display: grid; gap: clamp(0.3rem, 1vw, 0.5rem); }
  .wv__item {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.45rem;
    align-items: start;
    font-size: clamp(0.76rem, 1.9vw, 0.95rem); line-height: 1.3;
  }
  .wv__check { width: 0.85rem; height: 0.85rem; margin-top: 0.2em; color: var(--c-accent); }

  /* Finaler CTA */
  .wf__inner { display: grid; gap: var(--space-5); }
  .wf__title { max-width: 14ch; }
  .wf__lead { max-width: 44ch; color: var(--c-grey-dark); }
  .wf__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-3); }
  .wf__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6em 1em; margin-top: var(--space-4); }
</style>
