---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ServicesList from '@/components/ServicesList.astro';
import ContactCta from '@/components/ContactCta.astro';
import Words from '@/components/Words.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
import { breadcrumb } from '@/lib/schema';
---
<BaseLayout title="Leistungen – Social Media, Film, Branding, Design" description={`Leistungen von LAMOR AGENCY ${site.address.city}: ${services.map((s) => s.title).join(', ')}.`} jsonLd={[breadcrumb([{ name: 'Services', path: '/services/' }])]}>
  <PageHeader kicker="Services" index="03" title="Services" titleLines={['What we', 'do.']} lead="Acht Disziplinen, ein Studio. Von der Idee über die Produktion bis zur Veröffentlichung." meta={`${services.length} Leistungen · ${site.address.city}`} />

  <section class="container section section--flush-top" aria-label="Leistungen im Detail">
    <ServicesList mode="full" headingLevel="h2" />
  </section>

  <section class="services-claim section" data-theme="dark" aria-label="Markenclaim">
    <div class="container">
      <p class="t-label t-muted" data-reveal="fade">{site.name}</p>
      <p class="t-display services-claim__text"><Words lines={site.claimLines as unknown as string[]} /></p>
    </div>
  </section>

  <ContactCta index="04" />
</BaseLayout>

<style>
  .services-claim { background: var(--c-ink); color: var(--c-paper); }
  .services-claim .t-label { margin-bottom: var(--space-6); }
  @media (min-width: 768px) { .services-claim__text :global(.line:nth-child(2)) { padding-left: 14vw; } }
</style>
