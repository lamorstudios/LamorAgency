---
/**
 * Startseite – die Dramaturgie:
 * Hero → Showreel → Vertrauen (Kunden + Zahlen) → Problem/Lösung → Leistungen
 * → Webdesign → Arbeiten → Prozess → Models → Branchen → Zahlen → Stimmen
 * → Preise → FAQ → Kontakt.
 *
 * Showreel und Trust stehen bewusst ganz vorn: Wer hier abspringt, soll die
 * Arbeit gesehen und die Referenzen gelesen haben.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Clients from '@/components/sections/Clients.astro';
import Comparison from '@/components/sections/Comparison.astro';
import Services from '@/components/sections/Services.astro';
import Showreel from '@/components/sections/Showreel.astro';
import WebsiteTeaser from '@/components/sections/WebsiteTeaser.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Process from '@/components/sections/Process.astro';
import ModelsTeaser from '@/components/sections/ModelsTeaser.astro';
import Industries from '@/components/sections/Industries.astro';
import Stats from '@/components/sections/Stats.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Pricing from '@/components/sections/Pricing.astro';
import Faq from '@/components/sections/Faq.astro';
import ContactCta from '@/components/ContactCta.astro';
import { site } from '@/data/site';
import { offerCatalog } from '@/lib/schema';
---
<BaseLayout
  title={`Werbeagentur München | Video, Social Media & Branding – ${site.name}`}
  description="LAMOR AGENCY aus München: Videoproduktion, Fotografie, Social Media, Webdesign, Branding und eigene Models. Über 500 Mio. Aufrufe auf unsere Arbeit. Jetzt Projekt anfragen."
  theme="dark"
  jsonLd={[offerCatalog()]}
>
  <Hero />
  <Showreel />
  <Clients />
  <Comparison />
  <Services />
  <WebsiteTeaser />
  <SelectedWork />
  <Process />
  <ModelsTeaser />
  <Industries />
  <Stats />
  <Testimonials />
  <Pricing compact />
  <Faq />
  <ContactCta />
</BaseLayout>
