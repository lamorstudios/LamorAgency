---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import AgencyStatement from '@/components/home/AgencyStatement.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import FeaturedProject from '@/components/home/FeaturedProject.astro';
import Statement from '@/components/home/Statement.astro';
import ServicesList from '@/components/ServicesList.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import Clients from '@/components/Clients.astro';
import ContactCta from '@/components/ContactCta.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { site } from '@/data/site';
---
<BaseLayout
  title={`${site.name} | Social Media, Film & Branding Agentur München`}
  description={site.description}
  theme="dark"
  bodyClass="has-bg-transitions"
>
  <Hero />
  <AgencyStatement />
  <SelectedWork />
  <FeaturedProject />
  <Statement />

  <section class="home-services section" data-theme="light" data-bg="light" aria-labelledby="services-title">
    <div class="container">
      <div class="home-services__head">
        <SectionLabel label="Leistungen" />
        <h2 class="t-say home-services__title" id="services-title" data-reveal>Neun Disziplinen,<br />ein Studio.</h2>
      </div>
      <ServicesList mode="compact" />
      <div class="home-services__more" data-reveal>
        <ArrowLink href="/services/" label="Alle Leistungen im Detail" />
      </div>
    </div>
  </section>

  <div data-theme="light" data-bg="light">
    <Clients />
  </div>

  <ContactCta />
</BaseLayout>

<style>
  .home-services { color: var(--c-ink); padding-block: var(--space-10) var(--space-9); }
  .home-services__head { margin-bottom: var(--space-8); }
  .home-services__title { max-width: 14ch; }
  .home-services__more { margin-top: var(--space-8); }
</style>
