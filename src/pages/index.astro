---
/**
 * Startseite – die Dramaturgie:
 * Video-Hero → Featured on → Showreel → Arbeit (Video/Talents) → Leistungen
 * → Projekte → Problem/Lösung → Webdesign → Prozess → Models → Kunden
 * → Branchen → Stimmen → Preise → FAQ → Kontakt.
 *
 * Wer visuelle Dienstleistungen verkauft, muss sie zeigen, bevor er sie
 * erklärt: Die ersten vier Bereiche sind Bild und Bewegtbild, erst danach
 * kommt Text.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroVideo from '@/components/sections/HeroVideo.astro';
import FeaturedOn from '@/components/sections/FeaturedOn.astro';
import EditorialWork from '@/components/sections/EditorialWork.astro';
import Clients from '@/components/sections/Clients.astro';
import Comparison from '@/components/sections/Comparison.astro';
import Services from '@/components/sections/Services.astro';
import Showreel from '@/components/sections/Showreel.astro';
import WebsiteTeaser from '@/components/sections/WebsiteTeaser.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Process from '@/components/sections/Process.astro';
import ModelsTeaser from '@/components/sections/ModelsTeaser.astro';
import Industries from '@/components/sections/Industries.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Pricing from '@/components/sections/Pricing.astro';
import Faq from '@/components/sections/Faq.astro';
import ContactCta from '@/components/ContactCta.astro';
import { site } from '@/data/site';
import { offerCatalog } from '@/lib/schema';
---
<BaseLayout
  title={`Werbeagentur München | Video, Social Media & Branding – ${site.name}`}
  description="LAMOR AGENCY aus München: Videoproduktion, Fotografie, Social Media, Webdesign, Branding und eigene Models. Über 500 Mio. Aufrufe auf unsere Arbeit. Jetzt Projekt anfragen."
  theme="dark"
  jsonLd={[offerCatalog()]}
>
  <HeroVideo />
  <FeaturedOn />
  <Showreel />
  <EditorialWork />
  <Services />
  <SelectedWork />
  <Comparison />
  <WebsiteTeaser />
  <Process />
  <ModelsTeaser />
  <Clients figures={false} />
  <Industries />
  <Testimonials />
  <Pricing compact />
  <Faq />
  <ContactCta />
</BaseLayout>
