---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Words from '@/components/Words.astro';
import ContactForm from '@/components/ContactForm.astro';
import Faq from '@/components/sections/Faq.astro';
import { site, social } from '@/data/site';
import { breadcrumb, faqPage } from '@/lib/schema';
---
<BaseLayout
  title="Kontakt – Projekt anfragen"
  description={`Projekt bei LAMOR AGENCY in ${site.address.city} anfragen: Video, Fotografie, Social Media, Webdesign, Branding und Models. ${site.email} · ${site.phone}`}
  theme="dark"
  jsonLd={[breadcrumb([{ name: 'Kontakt', path: '/contact/' }]), faqPage()]}
>
  <section class="contact" data-theme="dark" data-bg="dark">
    <header class="contact__head container">
      <p class="t-label t-muted" data-reveal="fade">Kontakt</p>
      <h1 class="t-hero contact__title">
        <Words lines={["Let's build something", 'people remember.']} />
      </h1>
      <p class="t-lead contact__lead" data-reveal style="--reveal-delay:250ms">
        Ein Projekt, eine Idee oder erst eine Frage: Schreib uns – du bekommst eine
        ehrliche Einschätzung, kein Verkaufsgespräch.
      </p>
    </header>

    <div class="contact__grid container">
      <div class="contact__form"><ContactForm /></div>

      <aside class="contact__aside">
        <div class="contact__block" data-reveal>
          <p class="t-label t-muted">Direkt</p>
          <a href={`mailto:${site.email}`} class="contact__big link">{site.email}</a>
          <a href={site.phoneHref} class="contact__big link">{site.phone}</a>
          <a href={site.whatsapp} class="contact__wa" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="contact__wa-icon">
              <path d="M12.04 2A9.9 9.9 0 0 0 2.1 11.9c0 1.75.46 3.46 1.34 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01a9.9 9.9 0 0 0 9.9-9.9A9.9 9.9 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.22 8.22 0 1 1 6.97 3.86Zm4.5-6.15c-.25-.13-1.46-.72-1.69-.8-.22-.08-.39-.13-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.36-2.94c-.25-.44.25-.4.72-1.35.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3c-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.68 1.55.67 2.16.72 2.93.61.47-.07 1.46-.6 1.66-1.18.2-.57.2-1.06.15-1.17-.06-.1-.22-.17-.47-.29Z"/>
            </svg>
            <span class="t-label">WhatsApp schreiben</span>
          </a>
        </div>

        <div class="contact__block" data-reveal style="--reveal-delay:80ms">
          <p class="t-label t-muted">Studio</p>
          <address class="t-body">{site.name}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</address>
        </div>

        <div class="contact__block" data-reveal style="--reveal-delay:160ms">
          <p class="t-label t-muted">Social</p>
          {social.map((s) => (
            <a href={s.href} class="t-body link" target="_blank" rel="noopener noreferrer">{s.label} <span class="t-muted">{s.handle}</span></a>
          ))}
        </div>

        <div class="contact__block" data-reveal style="--reveal-delay:240ms">
          <p class="t-label t-muted">Ablauf</p>
          <ol class="contact__steps t-small">
            <li>Du schickst uns dein Projekt.</li>
            <li>Wir melden uns mit Rückfragen oder direkt mit einer Einschätzung.</li>
            <li>Erstgespräch – kostenlos und unverbindlich.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <Faq />
</BaseLayout>

<style>
  .contact { background: var(--c-ink); color: var(--c-paper); }
  .contact__head { padding-top: calc(var(--header-h) + var(--space-8)); padding-bottom: var(--space-8); display: grid; gap: var(--space-6); }
  .contact__title { margin-left: -0.03em; }
  @media (min-width: 768px) { .contact__title :global(.line:nth-child(2)) { padding-left: 10vw; } }
  .contact__lead { max-width: 42ch; }

  .contact__grid { display: grid; gap: var(--space-9); padding-bottom: var(--space-10); }
  .contact__aside { display: grid; gap: var(--space-7); align-content: start; }
  .contact__block { display: grid; gap: var(--space-3); justify-items: start; }
  .contact__block address { font-style: normal; line-height: 1.6; }
  .contact__block .link { min-height: 44px; display: inline-flex; align-items: center; }
  .contact__big { font-family: var(--font-display); font-size: var(--fs-h4); letter-spacing: var(--ls-snug); overflow-wrap: anywhere; }

  .contact__wa {
    display: inline-flex; align-items: center; gap: 0.6em;
    min-height: 44px; margin-top: var(--space-2);
    padding: 0.7em 1.1em;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .contact__wa-icon { width: 1.15rem; height: 1.15rem; flex-shrink: 0; }
  .contact__wa:hover { background: var(--c-accent); border-color: var(--c-accent); color: #fff; }

  .contact__steps { display: grid; gap: var(--space-2); padding-left: 1.2em; color: var(--fg-muted); max-width: 34ch; }
  .contact__steps li::marker { color: var(--c-accent); }

  @media (min-width: 900px) {
    .contact__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: var(--space-10); }
    .contact__aside { position: sticky; top: calc(var(--header-h) + var(--space-6)); }
  }
</style>
