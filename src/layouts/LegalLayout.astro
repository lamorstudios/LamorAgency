---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { breadcrumb } from '@/lib/schema';
interface Props { title: string; description: string; path: string; updated?: string }
const { title, description, path, updated } = Astro.props;
---
<BaseLayout title={title} description={description} jsonLd={[breadcrumb([{ name: title, path }])]}>
  <PageHeader kicker="Legal" title={title} size="h1" meta={updated ? `Stand: ${updated}` : undefined} />
  <section class="legal container">
    <div class="prose legal__content" data-reveal="fade">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding-bottom: var(--space-10); }
  .legal__content { max-width: 72ch; }
  .legal__content :global(.todo) { display: inline-block; padding: 0.15em 0.5em; border: 1px dashed var(--c-accent); color: var(--c-accent); font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: var(--ls-wide); text-transform: uppercase; }
</style>
