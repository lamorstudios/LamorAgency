---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import type { Props as SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Cursor from '@/components/Cursor.astro';
import Intro from '@/components/Intro.astro';
import { site, social } from '@/data/site';

interface Props extends SEOProps {
  theme?: 'light' | 'dark';
  bodyClass?: string;
  /**
   * Farbpalette der Seite.
   *   'warm'  bisherige Palette (Knochenpapier, warmes Nahschwarz).
   *           Standard – jede bestehende Seite bleibt damit unveraendert,
   *           insbesondere die Webdesign-Landingpage.
   *   'mono'  Schwarz, Weiss, Hellgrau, ein Akzent. Die Hauptwebsite.
   * Definition der Werte: src/styles/tokens.css
   */
  palette?: 'warm' | 'mono';
}
const { theme = 'light', bodyClass = '', palette = 'warm', jsonLd = [], ...seo } = Astro.props;

/** Flaechenfarbe fuer die Browser-UI – muss zur Palette passen. */
const themeColor = palette === 'mono'
  ? (theme === 'dark' ? '#000000' : '#ffffff')
  : (theme === 'dark' ? '#0b0a09' : '#f2ede4');

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  slogan: site.claim,
  description: site.description,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressRegion: site.address.region, addressCountry: site.address.country },
  areaServed: { '@type': 'City', name: site.geoArea },
  sameAs: social.map((s) => s.href),
  knowsAbout: ['Social Media Marketing', 'Content Creation', 'Videoproduktion', 'Fotografie', 'Branding', 'Grafikdesign', 'Webdesign', 'Creative Direction'],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  inLanguage: site.lang,
  publisher: { '@id': `${site.url}/#organization` },
};
---
<!doctype html>
<html lang={site.lang} data-theme={theme} data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} jsonLd={[organization, website, ...jsonLd]} />
    <script is:inline>
      /* --------------------------------------------------------------------
         PROGRESSIVE ENHANCEMENT – laeuft vor dem ersten Paint.
         `.js` schaltet die Reveal-Animationen ueberhaupt erst scharf.
         Der Watchdog nimmt die Klasse wieder weg, falls das Motion-Modul
         nicht startet (JS-Fehler, Bundle blockiert, sehr langsames Geraet).
         Damit kann Inhalt niemals dauerhaft auf opacity: 0 haengen bleiben.
         -------------------------------------------------------------------- */
      (function () {
        var el = document.documentElement;
        var reduced = false;
        try { reduced = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        if (!reduced) el.classList.add('js');

        // Intro nur beim ersten Aufruf pro Session, nicht bei Reduced Motion.
        try {
          if (!reduced && !sessionStorage.getItem('lamor-intro')) {
            el.setAttribute('data-intro', '');
            sessionStorage.setItem('lamor-intro', '1');
          }
        } catch (e) {}

        // Watchdog: ohne laufendes Motion-System wird alles sichtbar gemacht.
        var release = function () {
          if (el.getAttribute('data-motion') !== 'ready') el.classList.remove('js');
        };
        setTimeout(release, 2500);
        window.addEventListener('error', function (e) {
          if (e && e.target && e.target.tagName === 'SCRIPT') release();
        }, true);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass} id="top">
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Intro />
    <Header />
    <main id="main" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
