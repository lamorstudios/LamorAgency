---
import { getCollection } from 'astro:content';
import WorkAct from '@/components/WorkAct.astro';
import ArrowLink from '@/components/ArrowLink.astro';
const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const [a, b, c, d, e, f] = projects;
---
<section class="work" id="work" data-theme="light" data-bg="light" aria-labelledby="work-title">
  <div class="container work__head">
    <h2 class="t-say work__title" id="work-title" data-reveal>Arbeiten, die man<br />fühlt statt überspringt.</h2>
    <p class="t-label work__meta" data-reveal="fade">Selected Work</p>
  </div>

  {a && <WorkAct project={a} index={0} variant="takeover" priority />}
  {b && <WorkAct project={b} index={1} variant="offset" />}

  <div class="container work__pair">
    {c && <WorkAct project={c} index={2} variant="portrait" />}
    {d && <WorkAct project={d} index={3} variant="portrait" />}
  </div>

  {e && <WorkAct project={e} index={4} variant="accent" />}
  {f && <WorkAct project={f} index={5} variant="wide" />}

  <div class="container work__more" data-reveal>
    <ArrowLink href="/work/" label="Alle Projekte ansehen" />
  </div>
</section>

<style>
  .work { color: var(--c-ink); padding-block: var(--space-9) var(--space-8); overflow: hidden; }
  .work__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-8); }
  .work__title { max-width: 18ch; }
  .work__meta { color: var(--fg-muted); }
  .work__pair { display: grid; gap: var(--space-6); }
  .work__more { margin-top: var(--space-8); }
  @media (min-width: 768px) {
    .work__head { grid-template-columns: 1fr auto; align-items: end; }
    .work__meta { text-align: right; }
    .work__pair { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); align-items: start; }
    .work__pair > :global(.act:first-child) { grid-column: 1 / 6; }
    .work__pair > :global(.act:last-child) { grid-column: 7 / 12; margin-top: var(--space-9); }
  }
</style>
