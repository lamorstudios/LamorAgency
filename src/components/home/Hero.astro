---
import Words from '@/components/Words.astro';
import Media from '@/components/Media.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
/**
 * Hero – Fullscreen, Claim extrem groß, Showreel-Fläche (temporäre Surface).
 * Showreel einsetzen: showreel = { type: 'video', src: '/media/showreel.mp4', poster: '/src/assets/brand/showreel-poster.jpg', alt: 'LAMOR Showreel' }
 */
const showreel = { type: 'placeholder' as const, label: 'SHOWREEL / HERO VIDEO', alt: 'LAMOR AGENCY Showreel', ratio: 'wide' as const };
const band = [...services.map((s) => s.title), 'München', 'Feel the brand, not the ad.'];
---
<section class="hero" data-hero data-theme="dark" data-bg="dark" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__top">
      <p class="t-label hero__kicker" data-reveal="fade">
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Creative Studio</span>
        <span class="t-muted">— {site.address.city}</span>
      </p>
      <p class="t-label hero__kicker hero__kicker--right hide-mobile" data-reveal="fade" style="--reveal-delay:120ms">
        <span>Social Media · Film · Branding · Design</span>
      </p>
    </div>

    <div class="hero__media" data-hero-media data-reveal="fade" style="--reveal-delay:200ms">
      <div class="hero__media-clip" data-hero-clip>
        <Media media={showreel} priority hover={false} autoplay surface={1} />
      </div>
      <p class="hero__media-tag t-label" aria-hidden="true">
        <span class="hero__rec"></span>
        <span>Showreel</span>
        <span class="t-num" data-timecode>00:00:00:00</span>
      </p>
    </div>

    <h1 class="hero__title t-hero" id="hero-title" data-hero-title>
      <Words lines={['Feel the brand,']} class="hero__l1" />
      <Words lines={['not the ad.']} class="hero__l2 t-outline" delay={220} />
    </h1>

    <div class="hero__bottom">
      <p class="hero__intro t-body" data-reveal="fade" style="--reveal-delay:900ms">
        Social Media, Film, Branding und Design aus einem Studio.
        <span class="t-muted">Für Marken, die man fühlt statt überspringt.</span>
      </p>
      <a href="#studio" class="hero__scroll t-label" data-reveal="fade" style="--reveal-delay:1000ms" aria-label="Weiter scrollen">
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>

  <div class="hero__band" aria-hidden="true">
    <div class="hero__band-track">
      {[...band, ...band].map((w) => <span>{w}<i>✦</i></span>)}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; color: var(--c-paper); overflow: hidden; }
  .hero__inner {
    position: relative; min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto auto; gap: var(--space-6);
    padding-top: calc(var(--header-h) + var(--space-4)); padding-bottom: var(--space-7);
  }
  .hero__top { display: flex; justify-content: space-between; gap: var(--space-4); }
  .hero__kicker { display: flex; align-items: center; gap: 0.6em; flex-wrap: wrap; }
  .hero__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-accent) 60%, transparent); animation: hero-pulse 2.4s ease-out infinite; }
  @keyframes hero-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-accent) 60%, transparent); } 100% { box-shadow: 0 0 0 0.75rem transparent; } }
  .hero__media { position: relative; width: 100%; align-self: start; }
  .hero__media-clip { clip-path: inset(100% 0 0 0); transform: scale(1.06); transition: clip-path 1.3s var(--ease-expo) 0.15s, transform 1.6s var(--ease-out) 0.15s; }
  .hero__media-clip.is-inview, [data-reveal].is-inview .hero__media-clip { clip-path: inset(0 0 0 0); transform: none; }
  .hero__media :global(.media) { --ratio: 16 / 9; }
  .hero__media-tag { position: absolute; left: var(--space-4); bottom: var(--space-4); display: inline-flex; align-items: center; gap: 0.7em; padding: 0.55em 0.8em; background: rgba(5,5,5,0.6); backdrop-filter: blur(8px); color: #fff; }
  .hero__rec { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--c-accent); animation: rec 1.2s steps(2, end) infinite; }
  @keyframes rec { 50% { opacity: 0.25; } }
  .hero__title { position: relative; z-index: 1; margin-top: auto; }
  .hero__l2 { display: block; }
  .hero__bottom { display: flex; justify-content: space-between; align-items: end; gap: var(--space-6); }
  .hero__intro { max-width: 30rem; }
  .hero__intro .t-muted { display: block; }
  .hero__scroll { display: inline-flex; align-items: center; gap: 0.75em; min-height: 44px; flex-shrink: 0; }
  .hero__scroll-line { width: 3rem; height: 1px; background: currentColor; position: relative; overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; background: var(--c-accent); transform: translateX(-100%); animation: scroll-line 1.8s var(--ease-in-out) infinite; }
  @keyframes scroll-line { 0% { transform: translateX(-100%); } 50% { transform: translateX(0); } 100% { transform: translateX(100%); } }

  /* Akzent-Band als Übergang */
  .hero__band { position: relative; z-index: 1; background: var(--c-accent); color: #fff; overflow: hidden; padding-block: 0.7rem; }
  .hero__band-track { display: flex; width: max-content; gap: 2em; animation: band 38s linear infinite; font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: var(--ls-wider); text-transform: uppercase; }
  .hero__band-track span { display: inline-flex; gap: 2em; white-space: nowrap; }
  .hero__band-track i { font-style: normal; opacity: 0.7; }
  @keyframes band { to { transform: translateX(-50%); } }

  @media (min-width: 900px) {
    .hero__inner { grid-template-rows: auto 1fr auto auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }
    .hero__top { grid-column: 1 / -1; }
    .hero__media { grid-column: 7 / -1; grid-row: 2; margin-top: var(--space-2); max-width: 46rem; justify-self: end; width: 100%; }
    .hero__title { grid-column: 1 / -1; grid-row: 3; margin-top: calc(-1 * var(--space-9)); }
    .hero__l2 { padding-left: 16vw; }
    .hero__bottom { grid-column: 1 / -1; grid-row: 4; }
  }
  @media (min-width: 900px) and (max-height: 820px) { .hero__media { max-width: 34rem; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after, .hero__band-track, .hero__dot, .hero__rec { animation: none; }
    .hero__media-clip { clip-path: none; transform: none; transition: none; }
  }
</style>

<script>
  // Laufender Timecode im Showreel-Tag (rein dekorativ)
  let raf = 0;
  function initTimecode() {
    const el = document.querySelector<HTMLElement>('[data-timecode]');
    cancelAnimationFrame(raf);
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const start = performance.now();
    const tick = (now: number) => {
      const t = (now - start) / 1000; const f = Math.floor((t % 1) * 25);
      const s = Math.floor(t) % 60, m = Math.floor(t / 60) % 60, h = Math.floor(t / 3600);
      el.textContent = [h, m, s, f].map((n) => String(n).padStart(2, '0')).join(':');
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }
  document.addEventListener('astro:page-load', initTimecode);
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf));
</script>
