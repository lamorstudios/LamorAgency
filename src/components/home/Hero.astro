---
import Words from '@/components/Words.astro';
import Media from '@/components/Media.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';
/** Hero: nahezu Fullscreen, Claim extrem groß, Showreel-Fläche vorbereitet. */
const showreel = { type: 'placeholder' as const, label: '[SHOWREEL / HERO VIDEO]', alt: 'LAMOR AGENCY Showreel', ratio: 'wide' as const };
// Sobald ein Showreel vorliegt: { type: 'video', src: '/media/showreel.mp4', poster: '/src/assets/brand/showreel-poster.jpg', alt: '…' }
---
<section class="hero" data-hero data-theme="dark" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__top">
      <p class="t-label hero__kicker" data-reveal="fade">
        <span>Creative Studio</span>
        <span class="t-muted">— {site.address.city}</span>
      </p>
      <p class="t-label hero__kicker hero__kicker--right hide-mobile" data-reveal="fade" style="--reveal-delay:120ms">
        <span>Social Media · Film · Branding · Design</span>
      </p>
    </div>

    <div class="hero__media" data-hero-media data-reveal="fade" style="--reveal-delay:200ms">
      <Media media={showreel} priority hover={false} autoplay />
      <span class="hero__media-tag t-label">Showreel <span class="t-muted">— 00:00</span></span>
    </div>

    <h1 class="hero__title t-hero" id="hero-title" data-hero-title>
      <Words lines={[site.claimLines[0], site.claimLines[1]]} />
    </h1>

    <div class="hero__bottom">
      <ul role="list" class="hero__services t-label" data-reveal="fade" style="--reveal-delay:900ms">
        {services.slice(0, 5).map((s) => <li>{s.title}</li>)}
        <li class="t-muted">+ {services.length - 5} more</li>
      </ul>
      <a href="#work" class="hero__scroll t-label" data-reveal="fade" style="--reveal-delay:1000ms" aria-label="Zu den Arbeiten scrollen">
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--c-ink); color: var(--c-paper); overflow: hidden; }
  .hero__inner {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-6);
    padding-top: calc(var(--header-h) + var(--space-4));
    padding-bottom: var(--space-6);
  }
  .hero__top { display: flex; justify-content: space-between; gap: var(--space-4); }
  .hero__kicker { display: flex; gap: 0.5em; flex-wrap: wrap; }
  .hero__media { position: relative; width: 100%; align-self: start; }
  .hero__media :global(.media) { --ratio: 16 / 9; }
  .hero__media-tag { position: absolute; left: var(--space-4); bottom: var(--space-4); display: inline-flex; gap: 0.5em; padding: 0.5em 0.75em; background: rgba(10,10,10,0.55); backdrop-filter: blur(6px); }
  .hero__title { position: relative; z-index: 1; margin-top: auto; }
  .hero__title :global(.line:nth-child(2)) { padding-left: 0; }
  .hero__bottom { display: flex; justify-content: space-between; align-items: end; gap: var(--space-6); }
  .hero__services { display: flex; flex-wrap: wrap; gap: 0.4em 1.25em; max-width: 34rem; }
  .hero__scroll { display: inline-flex; align-items: center; gap: 0.75em; min-height: 44px; flex-shrink: 0; }
  .hero__scroll-line { width: 3rem; height: 1px; background: currentColor; position: relative; overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; background: var(--c-ink); transform: translateX(-100%); animation: scroll-line 1.8s var(--ease-in-out) infinite; }
  @keyframes scroll-line { 0% { transform: translateX(-100%); } 50% { transform: translateX(0); } 100% { transform: translateX(100%); } }

  @media (min-width: 900px) {
    .hero__inner { grid-template-rows: auto 1fr auto; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); padding-bottom: var(--space-7); }
    .hero__top { grid-column: 1 / -1; }
    .hero__media { grid-column: 7 / -1; grid-row: 2; margin-top: var(--space-4); max-width: 44rem; justify-self: end; }
    .hero__title { grid-column: 1 / -1; grid-row: 3; margin-top: calc(-1 * var(--space-9)); }
    .hero__title :global(.line:nth-child(2)) { padding-left: 12vw; }
    .hero__bottom { grid-column: 1 / -1; grid-row: 4; }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .hero__media { max-width: 32rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line::after { animation: none; } }
</style>
