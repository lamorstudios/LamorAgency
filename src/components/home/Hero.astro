---
import Words from '@/components/Words.astro';
import Media from '@/components/Media.astro';
import { site } from '@/data/site';
/**
 * Hero – Einstieg wie in eine Kampagne: fullscreen Showreel als Grund,
 * Claim in Kampagnentypografie darüber, eine Zeile läuft hinter dem Medium durch.
 * Showreel einsetzen: type: 'video', src: '/media/showreel.mp4', poster: '…'
 */
const showreel = { type: 'placeholder' as const, label: 'SHOWREEL / HERO VIDEO', alt: 'LAMOR AGENCY Showreel', ratio: 'wide' as const };
---
<section class="hero" data-hero data-theme="dark" data-bg="dark" aria-labelledby="hero-title">
  <div class="hero__bg" data-hero-media>
    <Media media={showreel} priority autoplay surface={1} sizes="100vw" />
    <div class="hero__veil" aria-hidden="true"></div>
  </div>

  <div class="hero__inner container">
    <p class="hero__credit t-label" data-reveal="fade">
      Creative Studio <span class="t-muted">— {site.address.city}</span>
    </p>

    <h1 class="hero__title" id="hero-title" data-hero-title>
      <span class="hero__l1 t-hero"><Words text="Feel the" /></span>
      <span class="hero__l2 t-hero"><Words text="brand," delay={120} /></span>
      <span class="hero__l3 t-hero t-outline"><Words text="not the ad." delay={240} /></span>
    </h1>

    <div class="hero__foot">
      <p class="hero__intro t-lead" data-reveal="fade" style="--reveal-delay:760ms">
        Social Media, Film, Branding und Design aus einem Studio in {site.address.city}.
      </p>
      <p class="hero__reel t-label" data-reveal="fade" style="--reveal-delay:820ms">
        <span class="hero__reel-mark" aria-hidden="true"></span>
        <span>Showreel</span>
      </p>
      <a href="#studio" class="hero__scroll t-label" data-reveal="fade" style="--reveal-delay:880ms">
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>

  <div class="hero__band" aria-hidden="true">
    <div class="hero__band-track">
      {[0, 1].map(() => (
        <span>Social Media <i>/</i> Content <i>/</i> Film <i>/</i> Fotografie <i>/</i> Branding <i>/</i> Design <i>/</i> Creative Direction <i>/</i></span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; color: var(--c-paper); overflow: hidden; background: #050505; }
  .hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hero__bg :global(.media) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
  .hero__bg :global(.media > *) { height: 100%; }
  .hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,5,5,0.5) 0%, rgba(5,5,5,0.06) 34%, rgba(5,5,5,0.34) 72%, rgba(5,5,5,0.72) 100%); }

  .hero__inner {
    position: relative; z-index: 2;
    min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto;
    padding-top: calc(var(--header-h) + var(--space-5));
    padding-bottom: var(--space-6);
  }
  .hero__credit { align-self: start; }
  .hero__title { align-self: center; display: grid; margin-block: var(--space-7); }
  .hero__l2 { padding-left: 6vw; }
  .hero__l3 { padding-left: 0; }
  .hero__title { margin-left: -0.03em; }
  .hero__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-4) var(--space-5); }
  .hero__reel { order: 3; }
  .hero__intro { max-width: 26ch; }
  .hero__reel { display: inline-flex; align-items: center; gap: 0.65em; }
  .hero__reel-mark { width: 0; height: 0; border-style: solid; border-width: 0.36rem 0 0.36rem 0.58rem; border-color: transparent transparent transparent var(--c-accent); }
  .hero__scroll { display: inline-flex; align-items: center; gap: 0.75em; min-height: 44px; }
  .hero__scroll-line { width: 3.5rem; height: 1px; background: rgba(255,255,255,0.5); position: relative; overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; background: var(--c-accent); transform: translateX(-100%); animation: scroll-line 2.2s var(--ease-in-out) infinite; }
  @keyframes scroll-line { 0% { transform: translateX(-100%); } 55% { transform: translateX(0); } 100% { transform: translateX(100%); } }

  /* Laufband als Übergang zur nächsten Fläche */
  .hero__band { position: relative; z-index: 2; background: var(--c-accent); color: #fff; overflow: hidden; padding-block: 0.55em; }
  .hero__band-track { display: flex; width: max-content; animation: band 46s linear infinite; }
  .hero__band-track span { display: inline-flex; gap: 0.55em; white-space: nowrap; padding-right: 0.55em; font-family: var(--font-display); font-size: clamp(0.95rem, 0.6rem + 1vw, 1.5rem); font-weight: var(--fw-semi); font-stretch: var(--wd-wide); letter-spacing: var(--ls-snug); text-transform: uppercase; }
  .hero__band-track i { font-style: normal; opacity: 0.55; }
  @keyframes band { to { transform: translateX(-50%); } }

  @media (min-width: 900px) {
    .hero__reel { order: 0; }
    .hero__l1 { padding-left: 0; }
    .hero__l2 { padding-left: 14vw; }
    .hero__l3 { padding-left: 5vw; }
    .hero__intro { max-width: 32ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__band-track, .hero__scroll-line::after { animation: none; }
  }
</style>
