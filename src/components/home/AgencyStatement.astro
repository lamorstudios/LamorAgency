---
import Words from '@/components/Words.astro';
import Media from '@/components/Media.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { site } from '@/data/site';
/** Studio-Moment: ein Satz, zwei Medien, eine Haltung. PLACEHOLDER COPY. */
---
<section class="studio" id="studio" data-theme="light" data-bg="light" aria-labelledby="studio-title">
  <div class="container studio__top">
    <SectionLabel label="Das Studio" />
    <h2 class="visually-hidden" id="studio-title">Das Studio</h2>
    <p class="studio__say t-h1 t-say">
      <Words text="Wir machen Marken sichtbar, ohne dass es sich nach Werbung anfühlt." />
    </p>
  </div>

  <div class="studio__spread">
    <div class="studio__media studio__media--big" data-reveal="fade">
      <Media media={{ type: 'placeholder', label: 'STUDIO IMAGE', alt: '', ratio: 'cinema' }} surface={5} reveal parallax sizes="(min-width: 900px) 62vw, 100vw" />
    </div>
    <div class="studio__media studio__media--small" data-reveal="fade" style="--reveal-delay:140ms">
      <Media media={{ type: 'placeholder', label: 'STUDIO IMAGE 2', alt: '', ratio: 'portrait' }} surface={4} reveal hover sizes="(min-width: 900px) 30vw, 66vw" />
    </div>
    <p class="studio__note t-lead" data-reveal>
      Konzept, Produktion und Veröffentlichung aus einer Hand — von der Idee bis zum letzten Frame.
    </p>
  </div>

  <div class="container studio__foot">
    <p class="studio__foot-text t-h3" data-reveal>
      Ein Studio in {site.address.city} für Social Media, Film, Fotografie, Branding und Design.
    </p>
    <ArrowLink href="/about/" label="Über LAMOR AGENCY" />
  </div>
</section>

<style>
  .studio { color: var(--c-ink); padding-block: var(--space-10) var(--space-9); overflow: hidden; }
  .studio__say { max-width: 22ch; font-size: var(--fs-h1); }
  .studio__spread { position: relative; margin-top: var(--space-9); display: grid; gap: var(--space-5); }
  .studio__media--big { width: 100vw; margin-left: 50%; transform: translateX(-50%); }
  .studio__media--small { width: 64%; margin-left: var(--gutter); margin-top: calc(-1 * var(--space-8)); position: relative; z-index: 2; }
  .studio__note { padding-inline: var(--gutter); max-width: 34ch; }
  .studio__foot { margin-top: var(--space-9); display: grid; gap: var(--space-5); justify-items: start; }
  .studio__foot-text { max-width: 24ch; }

  @media (min-width: 900px) {
    .studio__spread { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; gap: var(--grid-gap); }
    .studio__media--big { grid-column: 1 / 9; width: auto; margin-left: calc(-1 * var(--gutter)); transform: none; }
    .studio__media--small { grid-column: 9 / -1; width: auto; margin: 0 var(--gutter) calc(-1 * var(--space-8)) 0; }
    .studio__note { grid-column: 9 / -1; padding-inline: 0; padding-right: var(--gutter); margin-top: var(--space-6); }
    .studio__foot { grid-template-columns: 1fr auto; align-items: end; }
  }
</style>
