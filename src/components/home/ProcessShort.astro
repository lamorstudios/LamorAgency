---
/**
 * ============================================================================
 * ABLAUF IN DREI SCHRITTEN
 * ============================================================================
 *
 * Der vollstaendige Zehn-Schritte-Prozess steht weiterhin in
 * src/data/process.ts und gehoert auf die Agentur-Unterseite. Auf der
 * Startseite beantwortet dieser Abschnitt nur eine einzige Frage:
 * "Was passiert, wenn ich jetzt anfrage?"
 *
 * Drei Schritte, drei Zeilen. Keine Nutzenargumentation, keine Methoden,
 * keine Versprechen zu Dauer oder Preis – dafuer gibt es keine belastbare
 * Grundlage, und erfundene Zeitangaben waeren das Erste, woran die Seite
 * unglaubwuerdig wird.
 */
const schritte = [
  { nr: '01', titel: 'Gespräch', text: 'Du erzählst, was du vorhast. Wir sagen, was möglich ist.' },
  { nr: '02', titel: 'Produktion', text: 'Wir drehen, gestalten und bauen – ein Ansprechpartner, ein Termin.' },
  { nr: '03', titel: 'Übergabe', text: 'Du bekommst alles fertig in die Hand, einsatzbereit.' },
];
---
<section class="pr" data-theme="dark" data-bg="dark" aria-labelledby="pr-title">
  <div class="container">
    <h2 class="pr__title" id="pr-title" data-reveal="fade">So läuft es</h2>

    <ol class="pr__list" role="list">
      {schritte.map((s, i) => (
        <li class="pr__step" data-reveal style={`--reveal-delay:${100 + i * 110}ms`}>
          <span class="pr__nr">{s.nr}</span>
          <h3 class="pr__step-title">{s.titel}</h3>
          <p class="pr__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr { padding-block: clamp(2.5rem, 7vw, 5.5rem); }

  .pr__title {
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wider); text-transform: uppercase;
    color: var(--fg-muted);
  }

  .pr__list { display: grid; gap: clamp(1.75rem, 4vw, 2.5rem); }
  @media (min-width: 48rem) {
    .pr__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem); }
  }

  .pr__step { border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: clamp(0.9rem, 2vw, 1.25rem); }

  .pr__nr {
    font-size: var(--fs-eyebrow); font-variant-numeric: tabular-nums;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-wide);
    color: var(--c-accent-on-dark);
  }

  .pr__step-title {
    margin-top: var(--space-3);
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    font-size: clamp(1.4rem, 1rem + 1.8vw, 2.4rem);
    line-height: 1; letter-spacing: -0.035em; text-transform: uppercase; color: #fff;
  }

  .pr__text {
    margin-top: var(--space-3); max-width: 30ch;
    font-size: var(--fs-body); line-height: 1.5; color: rgba(255, 255, 255, 0.7);
  }
</style>
