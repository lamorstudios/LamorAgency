---
import { site } from '@/data/site';
/** Marken-Moment: der Claim übernimmt beim Scrollen die komplette Fläche in Electric Blue. */
---
<section class="statement" data-theme="dark" data-bg="dark" data-statement aria-label="Markenclaim">
  <div class="statement__sticky">
    <div class="statement__wash" data-statement-wash aria-hidden="true"></div>
    <div class="container statement__content">
      <p class="statement__text t-hero" aria-label={site.claim}>
        <span class="statement__line" data-statement-line aria-hidden="true">Feel</span>
        <span class="statement__line statement__line--b" data-statement-line aria-hidden="true">the brand,</span>
        <span class="statement__line statement__line--c" data-statement-line aria-hidden="true">not the ad.</span>
      </p>
      <p class="statement__sig t-label" data-statement-line aria-hidden="true">{site.name} — {site.address.city}</p>
    </div>
  </div>
</section>

<style>
  .statement { position: relative; color: var(--c-paper); height: 280svh; }
  .statement__sticky { position: sticky; top: 0; height: 100svh; display: grid; align-content: center; overflow: hidden; }
  .statement__wash { position: absolute; inset: 0; background: var(--c-accent); clip-path: inset(100% 0 0 0); will-change: clip-path; }
  .statement__content { position: relative; display: grid; gap: var(--space-5); }
  .statement__text { display: grid; font-size: clamp(2.6rem, 10.2vw, 9rem); line-height: 0.88; }
  .statement__line { display: block; will-change: transform, opacity; }
  .statement__line--b { padding-left: 14vw; }
  .statement__line--c { padding-left: 4vw; }
  .statement__sig { color: rgba(255,255,255,0.75); }
  @media (max-width: 899px) {
    .statement { height: 240svh; }
    .statement__line--b { padding-left: 6vw; }
    .statement__line--c { padding-left: 2vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .statement { height: auto; }
    .statement__sticky { position: relative; height: auto; padding-block: var(--space-10); }
    .statement__wash { clip-path: none; }
  }
</style>
