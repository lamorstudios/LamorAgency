---
import { getCollection } from 'astro:content';
import Media from '@/components/Media.astro';
import ArrowLink from '@/components/ArrowLink.astro';
/**
 * Sticky-Kapitel: das Medium bleibt stehen, der Text zieht durch, das Bild wechselt.
 * Kapiteltexte = PLACEHOLDER COPY über die Arbeitsweise, keine erfundenen Ergebnisse.
 */
const project = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)[0];
const chapters = [
  { title: 'Idee', text: 'Konzept, Look und Tonalität entstehen, bevor die Kamera läuft. Jede Arbeit beginnt mit der Frage, was die Marke fühlen lassen soll.', surface: 1 },
  { title: 'Produktion', text: 'Film, Foto und Content, produziert für Feed, Screen und Kampagne. Cinematic gedacht, plattformgerecht gebaut.', surface: 4 },
  { title: 'Wirkung', text: 'Social Media und digitales Marketing: Inhalte, die ankommen, geteilt werden und auf die Marke einzahlen.', surface: 6 },
];
---
<section class="feat" data-theme="dark" data-bg="dark" data-featured aria-labelledby="feat-title">
  <div class="feat__layout">
    <div class="feat__sticky">
      <div class="feat__media">
        {chapters.map((c, i) => (
          <div class={`feat__media-item ${i === 0 ? 'is-active' : ''}`} data-feat-media={i}>
            <Media media={{ type: 'placeholder', label: `FEATURED MEDIA — ${c.title}`, alt: '', ratio: 'wide' }} surface={c.surface} sizes="100vw" />
          </div>
        ))}
        <div class="feat__overlay container">
          <p class="t-label feat__eyebrow">So arbeiten wir</p>
          <h2 class="t-display feat__title" id="feat-title">{project.data.title}</h2>
        </div>
      </div>
    </div>

    <div class="feat__chapters container">
      {chapters.map((c, i) => (
        <div class="feat__chapter" data-feat-chapter={i}>
          <h3 class="t-h2 feat__chapter-title">{c.title}</h3>
          <p class="t-lead feat__text">{c.text}</p>
        </div>
      ))}
      <div class="feat__chapter feat__chapter--end">
        <p class="t-label t-muted">{project.data.client} · {project.data.services.join(' / ')}</p>
        <ArrowLink href={`/work/${project.id}/`} label="Projekt ansehen" />
      </div>
    </div>
  </div>
</section>

<style>
  .feat { color: var(--c-paper); }
  .feat__layout { position: relative; }
  .feat__sticky { position: sticky; top: 0; height: 58svh; z-index: 0; }
  .feat__media { position: relative; height: 100%; overflow: hidden; background: #050505; }
  .feat__media-item { position: absolute; inset: 0; opacity: 0; transition: opacity 1s var(--ease-out); }
  .feat__media-item :global(.media) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
  .feat__media-item :global(.media > *) { transform: scale(1.1); transition: transform 2s var(--ease-out); }
  .feat__media-item.is-active { opacity: 1; }
  .feat__media-item.is-active :global(.media > *) { transform: scale(1); }
  .feat__overlay { position: absolute; inset: auto 0 0 0; display: grid; gap: var(--space-2); padding-bottom: var(--space-6); padding-top: var(--space-9); background: linear-gradient(to top, rgba(5,5,5,0.8), transparent); pointer-events: none; }
  .feat__eyebrow { color: rgba(255,255,255,0.7); }
  .feat__chapters { position: relative; z-index: 1; display: grid; }
  .feat__chapter { min-height: 46svh; display: grid; align-content: center; gap: var(--space-3); padding-block: var(--space-8); }
  .feat__chapter--end { min-height: auto; padding-bottom: var(--space-9); gap: var(--space-4); justify-items: start; }
  .feat__text { max-width: 32ch; color: rgba(242,240,235,0.82); }

  @media (min-width: 900px) {
    .feat__layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .feat__sticky { height: 100svh; }
    .feat__chapters { padding-inline: var(--space-8) var(--gutter); }
    .feat__chapter { min-height: 100svh; padding-block: var(--space-9); }
    .feat__chapter--end { min-height: 52svh; }
    .feat__chapter-title { max-width: 8ch; }
  }
</style>
