---
/**
 * Hero – Fullscreen-Einstieg.
 *
 * Aufbau: Das Showreel ist der GRUND der Section, nicht ein Kasten darunter.
 * Darüber liegt ein Verlaufsschleier, damit die Typografie trägt, und darauf
 * die Headline in Versal-Groteske mit einem kursiven Serif-Einwurf.
 * Abgeschlossen wird der Block von einem randlosen Laufband mit dem Claim –
 * der harte Schnitt von Schwarz auf Papier ist der erste Section-Übergang.
 *
 * Showreel eintragen (bestehendes LAMOR-Material, kein Stock):
 *   const showreel = { type: 'video', src: '/media/showreel.mp4',
 *                      poster: '/src/assets/brand/showreel-poster.jpg', alt: '…' };
 */
import Media from '@/components/Media.astro';
import Words from '@/components/Words.astro';
import { site } from '@/data/site';

// PLACEHOLDER: durch das bestehende LAMOR-Showreel ersetzen (siehe README).
const showreel = {
  type: 'placeholder' as const,
  alt: 'LAMOR AGENCY Showreel',
  label: '[SHOWREEL] Hero-Video',
};

// Der Claim läuft als Endlosband – viermal im Markup, damit die Reihe breit genug ist.
const claim = 'Feel the brand. Not the ad.';
const claimRow = Array.from({ length: 4 }, () => claim);
---
<section class="hero" data-hero data-theme="dark" data-bg="dark" aria-labelledby="hero-title">
  <!-- Grund: Showreel über die volle Fläche, darüber der Schleier -->
  <div class="hero__bg" data-hero-media aria-hidden="true">
    <Media media={showreel} priority sizes="100vw" widths={[768, 1280, 1920, 2560]} class="hero__bg-media" />
    <span class="hero__scrim"></span>
    <span class="hero__grain"></span>
  </div>

  <div class="hero__frame container">
    <!-- Kopfzeile: Ort links, Beleg rechts -->
    <div class="hero__top">
      <p class="t-label hero__where">
        <span class="hero__dot" aria-hidden="true"></span>
        Creative Studio · {site.address.city}
      </p>
      <p class="t-label hero__reach">{site.reachClaim}</p>
    </div>

    <!-- Die Aussage. Drei Zeilen, kursiver Einwurf in der Mitte. -->
    <h1 class="hero__title" id="hero-title" data-hero-title>
      <span class="hero__line hero__line--1"><Words text="Marken," /></span>
      <span class="hero__line hero__line--2">
        <Words text="die man" delay={90} />
        <em class="t-serif-i hero__em">nicht</em>
      </span>
      <span class="hero__line hero__line--3"><Words text="übersieht." delay={180} /></span>
    </h1>

    <!-- Fusszeile: Lead, CTAs, Scroll-Hinweis -->
    <div class="hero__foot">
      <p class="hero__lead">
        Video, Fotografie, Social Media, Branding und Webdesign – zu Markenauftritten,
        die gesehen, verstanden und erinnert werden.
      </p>
      <div class="hero__actions">
        <a href="/contact/" class="btn" data-magnetic>
          <span>Projekt anfragen</span>
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
        <a href="/work/" class="hero__ghost" data-magnetic>
          <span>Arbeiten ansehen</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
        </a>
      </div>
      <p class="hero__cue t-label" aria-hidden="true"><span>Scroll</span></p>
    </div>
  </div>
</section>

<!-- Claim als randloses Laufband. Harter Schnitt Schwarz → Papier. -->
<div class="claim" data-theme="light" data-bg="light" role="presentation">
  <div class="marquee claim__marquee" style="--marquee-speed:34s; --marquee-gap:clamp(1.5rem,4vw,4rem)">
    <ul class="marquee__row">
      {claimRow.map(() => (
        <li class="claim__item">
          <span class="claim__text">Feel the brand.</span>
          <em class="claim__text claim__text--em t-serif-i">Not the ad.</em>
          <span class="claim__star" aria-hidden="true">✳</span>
        </li>
      ))}
    </ul>
    <ul class="marquee__row" aria-hidden="true">
      {claimRow.map(() => (
        <li class="claim__item">
          <span class="claim__text">Feel the brand.</span>
          <em class="claim__text claim__text--em t-serif-i">Not the ad.</em>
          <span class="claim__star" aria-hidden="true">✳</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ---------- Bühne ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    background: var(--c-ink);
    color: var(--c-paper);
    overflow: clip;
    isolation: isolate;
  }

  .hero__bg { position: absolute; inset: 0; z-index: 0; }
  .hero__bg :global(.media) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
  .hero__bg :global(.media > *) { height: 100%; }

  /* Zwei Schleier: einer von unten für die Fusszeile, einer diagonal für die
     Headline. Zusammen halten sie den Kontrast, ohne das Bild abzutöten. */
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(to top, rgba(11,10,9,0.94) 0%, rgba(11,10,9,0.55) 38%, rgba(11,10,9,0.15) 70%),
      linear-gradient(105deg, rgba(11,10,9,0.82) 0%, rgba(11,10,9,0.3) 55%, transparent 85%);
  }
  /* Feines Korn – nimmt dem Verlauf das Digitale. */
  .hero__grain {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    opacity: 0.2; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 0.6 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 160px 160px;
  }

  .hero__frame {
    position: relative;
    z-index: 3;
    flex: 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-6);
    padding-top: calc(var(--header-h) + var(--space-5));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  /* ---------- Kopfzeile ---------- */
  .hero__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3) var(--space-5); }
  .hero__where { display: inline-flex; align-items: center; gap: 0.7em; color: var(--c-paper); }
  .hero__reach { color: var(--c-grey-dark); }
  .hero__dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--c-accent-on-dark); flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__dot { animation: hero-pulse 2.6s var(--ease-in-out) infinite; }
    @keyframes hero-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  }

  /* ---------- Headline ---------- */
  .hero__title {
    align-self: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 100%;
    text-transform: uppercase;
    /* Eigene Grösse: das längste Wort ("ÜBERSIEHT.") muss in jeder
       Viewportbreite in den Container passen. */
    font-size: clamp(2.75rem, 0.1rem + 10vw, 8rem);
    /* 0.98 statt 0.9: darunter stossen die Umlautpunkte von Ü/Ä/Ö in die
       Zeile darueber. Deutscher Versalsatz braucht diesen Millimeter. */
    line-height: 0.98;
    letter-spacing: -0.04em;
    /* Optischer Ausgleich: Versalien wirken sonst eingerückt. */
    margin-left: -0.04em;
  }
  .hero__line { display: block; }
  .hero__line--2 { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.24em; }
  /* Der kursive Einwurf – die eine Stelle, an der die Serif spricht. */
  .hero__em { color: var(--c-accent-on-dark); }

  /* ---------- Fusszeile ---------- */
  .hero__foot { display: grid; gap: var(--space-5); align-content: end; padding-top: var(--space-5); }
  .hero__lead { max-width: 40ch; color: var(--c-grey-dark); font-size: var(--fs-body); line-height: 1.5; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }

  .hero__ghost {
    display: inline-flex; align-items: center; gap: 0.7em;
    min-height: 44px;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi);
    font-stretch: var(--wd-tight); letter-spacing: var(--ls-wide); text-transform: uppercase;
    border-bottom: 1px solid currentColor; padding-bottom: 0.35em;
    transition: color var(--dur-base) var(--ease-out);
  }
  .hero__ghost svg { width: 1em; height: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .hero__ghost:hover { color: var(--c-accent-on-dark); }
  .hero__ghost:hover svg { transform: translateX(0.35em); }

  .hero__cue { color: var(--c-grey-dark); display: none; }
  .hero__cue span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue span { animation: hero-cue 2.4s var(--ease-in-out) infinite; }
    @keyframes hero-cue { 0%, 100% { transform: translateY(0); opacity: 0.6; } 50% { transform: translateY(0.4rem); opacity: 1; } }
  }

  @media (min-width: 600px) {
    .hero__title { font-stretch: 118%; }
  }
  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-7);
    }
    .hero__cue { display: block; justify-self: end; }
    .hero__title { font-stretch: 125%; }
  }

  /* ---------- Claim-Laufband ---------- */
  .claim {
    background: var(--c-paper);
    color: var(--c-ink);
    padding-block: clamp(0.6rem, 1.6vw, 1.2rem);
    overflow: clip;
    border-bottom: 1px solid var(--c-paper-3);
  }
  .claim__item { display: flex; align-items: baseline; gap: clamp(0.5rem, 1.5vw, 1.2rem); flex: none; }
  .claim__text {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 118%;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 0.6rem + 4.6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .claim__text--em { color: var(--c-accent); }
  .claim__star { color: var(--c-accent); font-size: clamp(0.9rem, 2vw, 2rem); }
</style>
