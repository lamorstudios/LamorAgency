---
/**
 * ============================================================================
 * LEISTUNGEN MIT ERKLAERFILM
 * ============================================================================
 *
 * Der wichtigste Abschnitt der Startseite. Er beantwortet pro Disziplin die
 * drei Fragen, die ein Besucher in den ersten Sekunden stellt:
 *
 *   1. Was bringt mir das?        -> promise, gross gesetzt
 *   2. Was bekomme ich konkret?   -> drei Ergebnisse, keine Methoden
 *   3. Koennt ihr das wirklich?   -> ein Satz Technik + der Erklaerfilm
 *
 * Der Film ist dabei kein Schmuck, sondern der Beweis: Wer einen Erklaerfilm
 * sieht, den diese Agentur selbst gemacht hat, braucht keine Behauptung mehr
 * ueber die Qualitaet von Erklaerfilmen.
 *
 * ABWECHSELNDE SEITEN
 * Film und Text tauschen von Block zu Block die Spalte. Das haelt das Auge
 * wach, ohne dass eine einzige zusaetzliche Animation noetig waere.
 *
 * ASSET-SLOT
 * Die Filme werden zur Build-Zeit in /public/media gesucht
 * (erklaerfilm-<slug>.mp4). Fehlt der Film, bleibt der Block vollstaendig
 * und zeigt an seiner Stelle eine ruhige Flaeche mit der Ordnungszahl der
 * Disziplin – kein Platzhaltertext, kein "Video folgt", nichts Kaputtes.
 * Anleitung: public/media/README.md
 *
 * ABSPIELEN
 * autoplay, muted, loop, playsinline, ohne Bedienelemente. Dieselbe Logik
 * wie bei den uebrigen Filmen der Seite, siehe scripts/loop-video.ts.
 */
import { focusServices } from '@/data/services';
import { serviceFilm } from '@/lib/media-slots';
import Icon from '@/components/Icon.astro';

/** Film je Disziplin einmal zur Build-Zeit aufloesen. */
const bloecke = focusServices.map((s) => ({ service: s, film: serviceFilm(s.slug) }));
const mitFilm = bloecke.filter((b) => b.film.available).length;
---
<section class="sf" data-theme="dark" data-bg="dark" aria-labelledby="sf-title">
  <div class="container">
    <header class="sf__head">
      <p class="eyebrow sf__label" data-reveal="fade">Was wir machen</p>
      <h2 class="sf__title" id="sf-title" data-reveal>
        Vier Disziplinen.<br />
        <span class="sf__title-em">Ein Ansprechpartner.</span>
      </h2>
      <p class="sf__lead" data-reveal style="--reveal-delay:160ms">
        {mitFilm > 0
          ? 'Jede Leistung in unter einer Minute erklärt – von uns selbst produziert.'
          : 'Jede Leistung so beschrieben, dass du in einer Minute weißt, ob sie zu dir passt.'}
      </p>
    </header>

    <ol class="sf__list" role="list">
      {bloecke.map(({ service, film }, i) => (
        <li class="sf__item" data-flip={i % 2 === 1 ? 'true' : 'false'}>
          {/* ---- Film oder ruhige Ersatzflaeche ---- */}
          <div class="sf__media" data-reveal="fade" style="--reveal-delay:120ms">
            <div class="sf__frame">
              {film.available ? (
                <video
                  class="sf__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={film.poster}
                  disablepictureinpicture
                  aria-hidden="true"
                  tabindex="-1"
                  data-loop-video
                >
                  {film.webm && <source src={film.webm} type="video/webm" />}
                  {film.mp4 && <source src={film.mp4} type="video/mp4" />}
                </video>
              ) : (
                <div class="sf__quiet" aria-hidden="true">
                  <span class="sf__quiet-index">{service.index}</span>
                </div>
              )}
            </div>
          </div>

          {/* ---- Nutzen, Ergebnis, Technik ---- */}
          <div class="sf__copy">
            <p class="sf__index" data-reveal="fade">
              <span>{service.index}</span>
              <span class="sf__rule" aria-hidden="true"></span>
              <span class="sf__kind">{service.label}</span>
            </p>

            <h3 class="sf__name" data-reveal>{service.title}</h3>

            <p class="sf__promise" data-reveal style="--reveal-delay:80ms">{service.promise}</p>

            <ul class="sf__gets" role="list" data-reveal style="--reveal-delay:160ms">
              {service.deliverables.map((d) => (
                <li class="sf__get">
                  <Icon name="check" class="sf__tick" />
                  <span>{d}</span>
                </li>
              ))}
            </ul>

            <p class="sf__proof" data-reveal="fade" style="--reveal-delay:220ms">
              <span class="sf__proof-label">Technik</span>
              {service.proof}
            </p>

            <a href={`/services/#${service.slug}`} class="sf__more" data-reveal="fade" style="--reveal-delay:260ms">
              <span>{service.title} im Detail</span>
              <Icon name="arrow" />
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sf { padding-block: clamp(3rem, 8vw, 7rem); }

  /* ---------- Kopf ---------- */
  .sf__head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .sf__label { color: var(--c-accent-on-dark); }
  .sf__title {
    margin-top: var(--space-4);
    font-family: var(--font-display); font-weight: 900; font-stretch: 112%;
    font-size: clamp(2rem, 1rem + 4.2vw, 4.4rem);
    line-height: 0.98; letter-spacing: -0.038em; text-transform: uppercase;
  }
  .sf__title-em { color: var(--c-accent-on-dark); }
  .sf__lead {
    margin-top: var(--space-4); max-width: 42ch;
    color: var(--fg-muted); font-size: var(--fs-lead); line-height: 1.45;
  }

  /* ---------- Liste ---------- */
  .sf__list { display: grid; gap: clamp(3rem, 8vw, 6.5rem); }

  .sf__item { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); align-items: center; }
  @media (min-width: 900px) {
    .sf__item { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 5rem); }
    /* Jeder zweite Block spiegelt die Spalten. Reine Anordnung, keine
       Animation – und die Lesereihenfolge bleibt im Quelltext korrekt. */
    .sf__item[data-flip='true'] .sf__media { order: 2; }
  }

  /* ---------- Medienflaeche ---------- */
  .sf__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: clamp(0.75rem, 1.8vw, 1.25rem);
    overflow: hidden;
    background: var(--c-ink-2);
    border: 1px solid var(--card-dark-line);
    box-shadow: var(--card-dark-shadow);
    line-height: 0;
  }
  .sf__video { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Ohne Film: eine ruhige Flaeche mit der Ordnungszahl. Kein Hinweistext,
     nichts, was nach fehlendem Inhalt aussieht. */
  .sf__quiet {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    background:
      radial-gradient(120% 90% at 72% 18%, #221c18 0%, #15110f 46%, #0b0a09 100%);
  }
  .sf__quiet-index {
    font-family: var(--font-display); font-weight: 900; font-stretch: 118%;
    font-size: clamp(3.5rem, 9vw, 7rem); line-height: 1;
    color: rgba(242, 237, 228, 0.07);
    letter-spacing: -0.04em;
  }

  /* ---------- Text ---------- */
  .sf__index {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase;
    color: var(--fg-muted);
  }
  .sf__rule { flex: none; width: clamp(1.5rem, 4vw, 2.5rem); height: 1px; background: var(--c-accent); }
  .sf__kind { color: var(--c-accent-on-dark); }

  .sf__name {
    margin-top: var(--space-3);
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    font-size: clamp(1.75rem, 1rem + 2.8vw, 3.2rem);
    line-height: 1; letter-spacing: -0.035em; text-transform: uppercase;
  }

  .sf__promise {
    margin-top: var(--space-4); max-width: 34ch;
    font-size: clamp(1.05rem, 0.95rem + 0.7vw, 1.4rem);
    line-height: 1.4; color: var(--c-paper);
  }

  .sf__gets { margin-top: var(--space-5); display: grid; gap: 0.6rem; }
  .sf__get { display: flex; align-items: flex-start; gap: 0.65rem; color: var(--fg-muted); line-height: 1.45; }
  .sf__get :global(.icon),
  .sf__tick {
    flex: none; width: 1.05em; height: 1.05em; margin-top: 0.2em;
    color: var(--c-accent-on-dark);
  }

  /* Der Technik-Satz steht abgesetzt: Er ist Beleg, nicht Verkaufstext. */
  .sf__proof {
    margin-top: var(--space-5);
    padding-left: clamp(0.75rem, 2vw, 1rem);
    border-left: 1px solid var(--c-ink-3);
    max-width: 44ch;
    font-size: var(--fs-small); line-height: 1.55; color: var(--fg-muted);
  }
  .sf__proof-label {
    display: block; margin-bottom: 0.25rem;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--c-paper);
  }

  .sf__more {
    display: inline-flex; align-items: center; gap: 0.55em;
    min-height: 44px; margin-top: var(--space-5);
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase;
    color: var(--c-paper);
    border-bottom: 1px solid rgba(242, 237, 228, 0.3);
    padding-bottom: 0.25em;
  }
  .sf__more :global(.icon) { width: 1em; height: 1em; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .sf__more:hover { color: var(--c-accent-on-dark); border-bottom-color: var(--c-accent-on-dark); }
    .sf__more:hover :global(.icon) { transform: translateX(0.3em); }
  }
</style>

<script>
  import { watchLoopVideos } from '@/scripts/loop-video';
  watchLoopVideos();
</script>
