---
/**
 * "Alles aus einer Hand" – eine zusammenhängende Vergleichs-Komposition.
 *
 * Der entscheidende visuelle Griff: Die LAMOR-Spalte ist EINE durchgehende
 * Akzentfläche über alle Kategorien hinweg, nicht fünf einzelne Karten.
 * Links bleibt bewusst zurückhaltend (keine Fläche, gedämpfte Schrift),
 * rechts trägt Fläche, Haken und Kontrast. Das Auge liest in einem Zug
 * "das alles gehört zusammen" statt "hier sind fünf Vergleiche".
 *
 * REGEL: keine erfundenen Marktpreise, keine Wertung über Dritte. Links steht
 * ausschliesslich, wie die Beauftragung üblicherweise AUFGETEILT ist.
 */
import Media from '@/components/Media.astro';
import { websiteComparison, websiteEntryPrice, euro } from '@/data/website-pricing';

const assurances = [
  'Transparente Preise ab Erstgespräch',
  'Klare Projektphasen',
  'Ein persönlicher Ansprechpartner',
  'Responsive immer inklusive',
  'Keine versteckten Pflicht-Retainer',
  'Betreuung bleibt optional',
];
---
<section class="one" data-theme="dark" data-bg="dark" aria-labelledby="one-title">
  <div class="container">
    <header class="one__head">
      <p class="eyebrow">Der Unterschied</p>
      <h2 class="one__title" id="one-title">
        <span class="one__title-a">Woanders sind es fünf Aufträge.</span>
        <span class="one__title-b">Bei LAMOR ist es einer.</span>
      </h2>
      <p class="one__lead">
        Gute Freelancer und Agenturen gibt es viele. Der Aufwand entsteht nicht
        durch sie, sondern durch die Aufteilung: fünf Briefings, fünf Zeitpläne,
        fünf Bildsprachen – bevor überhaupt etwas online geht.
      </p>
    </header>

    <div class="one__wrap">
      <span class="one__glow" aria-hidden="true"></span>
      <span class="one__stamp">Alles aus einer Hand</span>

      <div class="one__matrix" role="table" aria-label="Vergleich: übliche Aufteilung und LAMOR AGENCY">
        <span class="one__col-a" role="columnheader">Üblicherweise</span>
        <span class="one__col-b" role="columnheader">LAMOR Agency</span>

        {websiteComparison.map((row) => (
          <>
            <p class="one__cat" role="rowheader">{row.category}</p>

            <div class="one__a" role="cell">
              <span class="one__mini">Üblicherweise</span>
              <p class="one__a-text">
                <span class="one__dash" aria-hidden="true"></span>
                {row.others}
              </p>
            </div>

            <div class="one__b" role="cell">
              <span class="one__mini one__mini--on">LAMOR</span>
              <ul class="one__list" role="list">
                {row.lamor.map((item) => (
                  <li class="one__item">
                    <span class="one__check" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              {row.note && <p class="one__note">{row.note}</p>}
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Abbinder: Zusagen und der Einstiegspreis, ohne neue Kartenreihe -->
    <div class="one__foot">
      <div class="one__foot-copy">
        <p class="one__foot-label t-label">Worauf du dich verlassen kannst</p>
        <ul class="chips" role="list">
          {assurances.map((a) => <li class="chip">{a}</li>)}
        </ul>
      </div>
      <a href="#anfrage" class="one__foot-cta">
        <span class="one__foot-price">ab {euro(websiteEntryPrice)}</span>
        <span class="one__foot-sub">Website anfragen</span>
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .one { padding-block: clamp(2.5rem, 6vw, 5rem); overflow: clip; }

  /* ---------- Kopf ---------- */
  .one__head { display: grid; gap: var(--space-4); margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .one__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 110%;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 0.7rem + 3.9vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    display: grid;
    max-width: 20ch;
  }
  /* Erste Zeile zurueckgenommen, zweite traegt den Akzent – die Aussage
     steht im Kontrast der beiden Zeilen, nicht in einem Ausrufezeichen. */
  .one__title-a { color: var(--c-grey-dark); }
  .one__title-b { color: var(--c-accent-on-dark); }
  .one__lead { max-width: 56ch; color: var(--fg-muted); }

  /* ---------- Matrix ---------- */
  .one__wrap { position: relative; padding-top: 0.9rem; }

  /* Sehr zurueckhaltender Schein hinter der Akzentspalte – gibt Tiefe,
     ohne in Neon zu kippen. */
  .one__glow {
    position: absolute;
    inset: -10% -6% -10% 40%;
    background: radial-gradient(60% 50% at 70% 50%, color-mix(in srgb, var(--c-accent) 22%, transparent), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .one__stamp {
    position: absolute;
    z-index: 3;
    top: 0;
    right: clamp(0.75rem, 3vw, 2rem);
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1em;
    border-radius: var(--radius-pill);
    background: var(--c-accent);
    color: #fff;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semi);
    font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    /* Sitzt bewusst halb auf der Oberkante der Akzentflaeche. */
    transform: translateY(-50%);
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.6);
  }

  .one__matrix {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: clamp(0.7rem, 1.8vw, 1.1rem);
    overflow: hidden;
    background: color-mix(in srgb, var(--c-ink-2) 70%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .one__col-a, .one__col-b { display: none; }

  .one__cat {
    grid-column: 1 / -1;
    padding: 0.65rem clamp(0.8rem, 2.2vw, 1.3rem);
    background: var(--c-ink);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-bold);
    font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--c-paper);
  }
  .one__cat:first-of-type { border-top: 0; }

  .one__a, .one__b {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: clamp(0.75rem, 2.2vw, 1.2rem) clamp(0.7rem, 2vw, 1.3rem);
    min-width: 0;
  }
  /* Die rechte Spalte ist durchgehend eingefaerbt – dadurch liest sie sich
     als EINE Flaeche und nicht als Reihe einzelner Karten. */
  .one__b { background: color-mix(in srgb, var(--c-accent) 13%, transparent); }
  .one__a { border-right: 1px solid var(--line); }

  .one__mini {
    font-size: 0.66rem; font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--fg-muted);
  }
  .one__mini--on { color: var(--c-accent-on-dark); }

  .one__a-text {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.5em; align-items: baseline;
    font-size: var(--fs-small); color: var(--fg-muted); overflow-wrap: break-word;
  }
  .one__dash { width: 0.75rem; height: 1px; background: currentColor; opacity: 0.6; align-self: start; margin-top: 0.62em; }

  .one__list { display: grid; gap: 0.35rem; }
  .one__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.55em; align-items: baseline; font-size: var(--fs-small); }
  .one__check {
    width: 0.9rem; height: 0.9rem; border-radius: 50%; align-self: start; margin-top: 0.15em; flex: none;
    background: var(--c-accent) no-repeat center / 0.52rem
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M2 6.5L4.8 9L10 3' stroke='white' stroke-width='2.2' stroke-linecap='square'/></svg>");
  }
  .one__note { font-size: 0.72rem; color: var(--c-accent-on-dark); }

  @media (min-width: 900px) {
    /* Kategorie links, beide Spalten daneben – die Akzentflaeche laeuft
       jetzt ununterbrochen von oben nach unten durch. */
    .one__matrix { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.15fr) minmax(0, 1.15fr); }
    .one__col-a, .one__col-b {
      display: block;
      padding: 0.7rem 1.3rem;
      font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
      letter-spacing: var(--ls-wider); text-transform: uppercase;
      border-bottom: 1px solid var(--line);
    }
    .one__col-a { grid-column: 2; color: var(--fg-muted); }
    .one__col-b { grid-column: 3; color: var(--c-accent-on-dark); background: color-mix(in srgb, var(--c-accent) 13%, transparent); }
    .one__cat {
      grid-column: 1;
      display: grid; align-content: center;
      background: transparent;
      border-right: 1px solid var(--line);
      font-size: 0.8rem;
      letter-spacing: var(--ls-wide);
    }
    .one__mini { display: none; }
    .one__a, .one__b { border-top: 1px solid var(--line); }
    .one__cat + .one__a { border-top: 1px solid var(--line); }
  }

  /* ---------- Abbinder ---------- */
  .one__foot {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .one__foot-label { color: var(--fg-muted); margin-bottom: var(--space-3); }

  .one__foot-cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(0.9rem, 2vw, 1.25rem) clamp(1.1rem, 2.5vw, 1.6rem);
    border: 1px solid var(--c-accent);
    border-radius: clamp(0.6rem, 1.6vw, 1rem);
    background: color-mix(in srgb, var(--c-accent) 12%, transparent);
    transition: background var(--dur-base) var(--ease-out);
  }
  .one__foot-cta:hover { background: color-mix(in srgb, var(--c-accent) 22%, transparent); }
  .one__foot-price {
    grid-column: 1;
    font-family: var(--font-display); font-weight: var(--fw-display); font-stretch: 118%;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.25rem); line-height: 1;
    letter-spacing: var(--ls-tight); font-variant-numeric: tabular-nums;
    color: var(--c-paper);
  }
  .one__foot-sub {
    grid-column: 2;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--c-accent-on-dark);
  }
  .one__foot-cta svg { grid-column: 3; width: 1.1rem; height: 1.1rem; color: var(--c-accent-on-dark); transition: transform var(--dur-base) var(--ease-out); }
  .one__foot-cta:hover svg { transform: translate(0.25em, -0.25em); }

  @media (min-width: 900px) {
    .one__foot { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-7); }
  }
</style>
