---
/**
 * "Einzeln organisiert – bei LAMOR aus einer Hand" als Vergleichsmatrix.
 *
 * Eine Komposition, keine fuenf Sections: links die Kategorie, in der Mitte der
 * uebliche Weg (zurueckhaltend), rechts eine durchgehende dunkle Spalte mit
 * rotem Schein – das ist die Antwort. Auch auf dem Telefon bleiben beide
 * Spalten nebeneinander; gekuerzt wird der Text, nicht der Vergleich.
 *
 * REGEL: Die mittlere Spalte beschreibt nur die Struktur des ueblichen Weges.
 * Keine Preise, keine Wertung ueber Dritte.
 */
import Icon from '@/components/Icon.astro';
import Words from '@/components/Words.astro';
import { websiteComparison, websiteEntryPrice, euro, carePlans } from '@/data/website-pricing';

const careFrom = Math.min(...carePlans.filter((c) => c.price > 0).map((c) => c.price));
---
<section class="one wash" data-theme="light" data-bg="light" aria-labelledby="one-title">
  <div class="container">
    <div class="one__head">
      <div>
        <p class="eyebrow one__label" data-reveal="fade">Der Unterschied</p>
        <h2 class="one__title" id="one-title">
          <Words text="Einzeln organisiert." />
          <span class="one__title-em">Bei LAMOR aus einer Hand.</span>
        </h2>
      </div>
      <p class="one__lead" data-reveal style="--reveal-delay:140ms">
        Fünf Gewerke, ein Projekt – und ein Ansprechpartner dafür.
      </p>
    </div>

    <div class="card card--light one__matrix" data-reveal>
      <!-- Kopfzeile der Matrix -->
      <div class="one__row one__row--head" aria-hidden="true">
        <span class="one__cat one__cat--head">Leistung</span>
        <span class="one__col-label">Einzeln organisiert</span>
        <span class="one__col-label one__col-label--good">Bei LAMOR</span>
      </div>

      {websiteComparison.map((row) => (
        <div class="one__row">
          <span class="one__cat">
            <span class="itile"><Icon name={row.icon} /></span>
            <span class="one__cat-name">{row.category}</span>
          </span>
          <span class="one__others">
            <span class="one__x" aria-hidden="true"><Icon name="close" /></span>
            {row.others}
          </span>
          <span class="one__lamor">
            <span class="one__check" aria-hidden="true"><Icon name="check" /></span>
            <span class="one__lamor-text">{row.lamor}</span>
            <span class="spill one__gain">{row.gain}</span>
          </span>
        </div>
      ))}

      <!-- Abschluss: der Preis-Einstieg statt eines Absatzes -->
      <div class="one__foot">
        <p class="one__foot-note">Betreuung optional ab {euro(careFrom)} / Monat</p>
        <a class="one__cta" href="#pakete">
          <span class="one__cta-price">ab {euro(websiteEntryPrice)}</span>
          <span class="one__cta-label">Pakete ansehen</span>
          <Icon name="arrow" class="one__cta-icon" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .one { padding-block: clamp(2.75rem, 6vw, 5.5rem); }

  .one__head { display: grid; gap: var(--space-3); margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem); }
  .one__label { color: var(--c-accent-text); }
  .one__title {
    font-family: var(--font-display); font-weight: 900; font-stretch: 112%;
    font-size: clamp(1.9rem, 0.9rem + 4.2vw, 4.2rem);
    line-height: 0.98; letter-spacing: -0.04em; max-width: 22ch; text-wrap: balance;
  }
  .one__title-em { color: var(--c-accent); }
  .one__lead { color: var(--fg-muted); max-width: 42ch; font-size: clamp(0.95rem, 2.2vw, 1.2rem); line-height: 1.45; }
  @media (min-width: 1024px) {
    .one__head { grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr); gap: var(--space-8); align-items: end; }
  }

  /* ---------- Die Matrix ----------
     Drei Spalten ab Tablet; darunter bleibt der Vergleich zweispaltig und die
     Kategorie sitzt als Zeile darueber. */
  .one__matrix { padding: clamp(0.6rem, 1.8vw, 1.25rem); overflow: hidden; }

  .one__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: 'cat cat' 'others lamor';
    gap: 0.35rem clamp(0.4rem, 1.4vw, 1rem);
    align-items: center;
    padding: clamp(0.5rem, 1.4vw, 0.85rem) clamp(0.35rem, 1vw, 0.75rem);
    position: relative;
  }
  .one__row + .one__row { border-top: 1px solid var(--card-light-line-soft); }

  .one__cat { grid-area: cat; display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .one__cat-name {
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    font-size: clamp(0.82rem, 2.2vw, 1.1rem); line-height: 1.05;
    letter-spacing: -0.025em; text-transform: uppercase;
  }
  .one__others {
    grid-area: others; display: flex; align-items: center; gap: 0.4rem;
    font-size: clamp(0.74rem, 1.9vw, 0.95rem); line-height: 1.25; color: var(--c-grey);
  }
  .one__x { display: grid; place-items: center; flex: none; width: 0.95rem; height: 0.95rem; color: var(--c-grey); opacity: 0.6; }

  /* Die LAMOR-Spalte laeuft als EINE dunkle Flaeche durch alle Zeilen. */
  .one__lamor {
    grid-area: lamor; display: flex; align-items: center; flex-wrap: wrap;
    gap: 0.3rem 0.45rem; min-width: 0;
    font-size: clamp(0.76rem, 1.9vw, 0.98rem); line-height: 1.25;
    font-weight: var(--fw-semi);
    padding: clamp(0.4rem, 1.2vw, 0.7rem) clamp(0.5rem, 1.4vw, 0.9rem);
    background: var(--card-dark-bg);
    border: 1px solid var(--card-dark-line);
    border-radius: calc(var(--radius-card) * 0.5);
    color: var(--c-paper);
  }
  .one__check { display: grid; place-items: center; flex: none; width: 1rem; height: 1rem; color: var(--c-accent-on-dark); }
  .one__lamor-text { min-width: 0; }
  .one__gain { display: none; }

  /* Auf dem Telefon sind Kreuz und Haken selbsterklaerend – die Kopfzeile
     kostet dort nur Hoehe. */
  .one__row--head { display: none; }
  @media (min-width: 760px) { .one__row--head { display: grid; padding-block: 0.35rem 0; } }

  /* Unter 760px: Haken links, Text rechts – kein Umbruch unter das Icon. */
  @media (max-width: 759px) {
    .one__lamor {
      display: grid; grid-template-columns: auto minmax(0, 1fr);
      align-items: start; gap: 0.4rem;
    }
    .one__check { margin-top: 0.1rem; }
  }
  .one__cat--head, .one__col-label {
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--c-grey);
  }
  .one__col-label--good { color: var(--c-accent-text); }
  .one__row--head .one__cat--head { grid-area: cat; }
  .one__row--head .one__col-label:nth-of-type(1) { grid-area: others; }
  .one__row--head .one__col-label--good { grid-area: lamor; padding-left: clamp(0.5rem, 1.4vw, 0.9rem); }

  /* Ab Tablet: echte drei Spalten, die dunkle Flaeche wird durchgehend. */
  @media (min-width: 760px) {
    .one__row {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-areas: 'cat others lamor';
      gap: clamp(0.5rem, 1.6vw, 1.25rem);
      padding-block: 0;
    }
    .one__row + .one__row { border-top: 0; }
    .one__cat, .one__others { padding-block: clamp(0.7rem, 1.6vw, 1rem); }
    .one__row + .one__row .one__cat,
    .one__row + .one__row .one__others { border-top: 1px solid var(--card-light-line-soft); }
    .one__lamor {
      border-radius: 0; border-inline: 0; border-block: 0;
      padding-block: clamp(0.7rem, 1.6vw, 1rem);
      align-self: stretch;
    }
    .one__row + .one__row .one__lamor { border-top: 1px solid var(--card-dark-line-soft); }
    /* Erste und letzte Zelle runden die durchgehende Spalte ab. */
    .one__row:last-of-type .one__lamor { border-radius: 0 0 calc(var(--radius-card) * 0.5) calc(var(--radius-card) * 0.5); }
    /* Der Kopf rundet oben ab, die Zeilen darunter stossen eckig an –
       sonst entsteht eine sichtbare Stufe in der durchgehenden Spalte. */
    .one__row--head { padding-bottom: 0; }
    .one__row--head .one__col-label--good {
      background: var(--card-dark-bg);
      color: var(--c-accent-on-dark);
      padding: 0.75rem clamp(0.5rem, 1.4vw, 0.9rem) 0.5rem;
      border-radius: calc(var(--radius-card) * 0.5) calc(var(--radius-card) * 0.5) 0 0;
      align-self: stretch;
    }
    .one__row--head .one__lamor { padding: 0; }
  }
  @media (min-width: 1100px) {
    .one__gain { display: inline-flex; margin-left: auto; }
  }

  /* ---------- Abschluss ---------- */
  .one__foot {
    display: grid; gap: var(--space-3);
    margin-top: clamp(0.6rem, 1.6vw, 1rem);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border-radius: calc(var(--radius-card) * 0.6);
    background: rgba(11, 10, 9, 0.04);
    border: 1px solid var(--card-light-line-soft);
  }
  @media (min-width: 620px) {
    .one__foot { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  }
  .one__foot-note { font-size: var(--fs-small); color: var(--c-grey); }
  .one__cta {
    display: inline-grid; grid-template-columns: auto auto auto; align-items: center;
    gap: 0.3rem 0.6rem; justify-self: start;
    padding: 0.7rem 1.1rem; border-radius: var(--radius-pill);
    background: var(--card-accent-bg); color: #fff;
    box-shadow: var(--card-accent-shadow);
    text-decoration: none;
  }
  .one__cta-price {
    grid-row: 1; grid-column: 1;
    font-family: var(--font-display); font-weight: var(--fw-display); font-stretch: 112%;
    font-size: clamp(1.05rem, 2.6vw, 1.5rem); line-height: 1; letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .one__cta-label {
    grid-row: 1; grid-column: 2;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; white-space: nowrap;
  }
  .one__cta-icon { grid-row: 1; grid-column: 3; width: 1.1em; height: 1.1em; }
  @media (hover: hover) and (pointer: fine) {
    .one__cta { transition: transform var(--dur-base) var(--ease-out); }
    .one__cta:hover { transform: translateY(-2px); }
  }
</style>
