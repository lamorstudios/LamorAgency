---
/**
 * Problem -> Loesung als EINE Komposition, nicht als Liste von Paaren.
 *
 * Links liegt der Ist-Zustand flach auf dem Papier: durchgestrichen, ruhig,
 * ohne Flaeche. Rechts steht das Gegenstueck als angehobene dunkle Tafel –
 * der optische Sprung zwischen beiden Haelften ist das eigentliche Argument.
 * Die Paare stehen in derselben Reihenfolge in src/data/website-pricing.ts.
 */
import Words from '@/components/Words.astro';
import Icon from '@/components/Icon.astro';
import { websiteProblems, websiteSolutions, websiteEntryPrice, euro } from '@/data/website-pricing';
---
<section class="wpr wash" data-theme="light" data-bg="light" aria-labelledby="wpr-title">
  <div class="container">
    <div class="wpr__head">
      <p class="eyebrow wpr__label" data-reveal="fade">Ausgangslage</p>
      <h2 class="wpr__title" id="wpr-title">
        <Words text="Sieht aus wie 2018?" />
        <span class="wpr__title-em t-serif-i">Das kostet dich Anfragen.</span>
      </h2>
    </div>

    <div class="wpr__pair" data-reveal>
      <!-- Ist-Zustand: zurueckhaltend -->
      <article class="card card--light wpr__side wpr__side--before">
        <header class="wpr__side-head">
          <span class="rmark rmark--bad"><Icon name="minus" /></span>
          <h3 class="wpr__side-title">Aktueller Stand</h3>
        </header>
        <ul class="wpr__list" role="list">
          {websiteProblems.map((p) => (
            <li class="wpr__item">
              <span class="wpr__mark" aria-hidden="true"><Icon name="close" /></span>
              <span class="wpr__text">{p}</span>
            </li>
          ))}
        </ul>
      </article>

      <span class="vs wpr__vs" aria-hidden="true">vs.</span>

      <!-- Soll-Zustand: die Antwort -->
      <article class="card card--dark wpr__side wpr__side--after">
        <header class="wpr__side-head">
          <span class="rmark rmark--good"><Icon name="check" /></span>
          <h3 class="wpr__side-title">Mit LAMOR AGENCY</h3>
        </header>
        <ul class="wpr__list" role="list">
          {websiteSolutions.map((sol) => (
            <li class="wpr__item">
              <span class="wpr__mark wpr__mark--good" aria-hidden="true"><Icon name="check" /></span>
              <span class="wpr__text">{sol}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="wpr__foot" data-reveal>
      <p class="wpr__outro">Aus einer alten Seite wird ein digitaler Markenauftritt.</p>
      <a class="wpr__cta" href="#pakete">
        <span class="wpr__cta-price">ab {euro(websiteEntryPrice)}</span>
        <span class="wpr__cta-label">Pakete ansehen</span>
        <Icon name="arrow" class="wpr__cta-icon" />
      </a>
    </div>

  </div>
</section>

<style>
  .wpr { padding-block: clamp(2.5rem, 6vw, 5rem); }

  .wpr__head { display: grid; gap: var(--space-4); margin-bottom: clamp(1.75rem, 4vw, 3rem); }
  .wpr__label { color: var(--c-accent-text); }
  .wpr__title {
    font-family: var(--font-display); font-weight: 900; font-stretch: 118%;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 0.7rem + 4.2vw, 4.2rem);
    line-height: 0.95; letter-spacing: -0.045em;
  }
  .wpr__title-em { display: block; color: var(--c-accent-text); text-transform: none; letter-spacing: -0.02em; }

  /* ---------- Die zwei Haelften ----------
     Der Vergleich bleibt auch auf dem Telefon nebeneinander. */
  .wpr__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(0.5rem, 1.6vw, 2.25rem);
    align-items: stretch;
    position: relative;
  }
  .wpr__side { padding: clamp(0.75rem, 2.2vw, 1.6rem); }

  /* Beide Spalten teilen sich dieselben Zeilen, damit jedes Paar auf einer
     Hoehe steht. Ohne Subgrid-Unterstuetzung bleibt die Darstellung gueltig,
     nur die Zeilen sitzen dann nicht exakt aufeinander. */
  @supports (grid-template-rows: subgrid) {
    .wpr__pair { grid-template-rows: auto repeat(8, auto); }
    .wpr__side { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; align-content: start; }
    .wpr__list { grid-row: 2 / -1; display: grid; grid-template-rows: subgrid; }
    .wpr__item { align-content: center; }
  }
  .wpr__vs { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 3; }

  .wpr__side-head {
    display: flex; align-items: center; gap: clamp(0.45rem, 1.4vw, 0.8rem);
    padding-bottom: clamp(0.5rem, 1.4vw, 0.9rem);
    border-bottom: 1px solid var(--card-line);
    margin-bottom: clamp(0.3rem, 1vw, 0.5rem);
  }
  .wpr__side-title {
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    font-size: clamp(0.82rem, 2.3vw, 1.4rem); line-height: 1.05; letter-spacing: -0.03em;
    min-width: 0; hyphens: auto;
  }
  /* Unter 400px bekommt "Mit LAMOR AGENCY" die volle Spaltenbreite. */
  @media (max-width: 399px) {
    .wpr__side-head { display: grid; justify-items: start; gap: 0.4rem; }
  }

  .wpr__list { display: grid; }
  .wpr__item {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.35rem, 1.2vw, 0.6rem); align-items: start;
    padding-block: clamp(0.45rem, 1.3vw, 0.7rem);
  }
  .wpr__item + .wpr__item { border-top: 1px solid var(--card-line); }
  .wpr__mark { width: 0.9rem; height: 0.9rem; margin-top: 0.2em; color: var(--card-muted); opacity: 0.6; }
  .wpr__mark--good { color: var(--c-accent-on-dark); opacity: 1; }
  .wpr__text { font-size: clamp(0.76rem, 1.9vw, 0.98rem); line-height: 1.3; }
  .wpr__side--before .wpr__text {
    color: var(--c-grey);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }
  .wpr__side--after .wpr__text { font-weight: var(--fw-semi); }

  /* ---------- Abschluss ---------- */
  .wpr__foot {
    display: grid; gap: var(--space-3);
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    padding: clamp(0.85rem, 2.2vw, 1.4rem);
    border-radius: calc(var(--radius-card) * 0.7);
    background: rgba(11, 10, 9, 0.04);
    border: 1px solid var(--card-light-line-soft);
  }
  @media (min-width: 620px) {
    .wpr__foot { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-5); }
  }
  .wpr__outro {
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    text-transform: uppercase; font-size: clamp(0.95rem, 2.4vw, 1.5rem);
    line-height: 1.05; letter-spacing: -0.03em; max-width: 24ch;
  }
  .wpr__cta {
    display: inline-grid; grid-template-columns: auto auto auto; align-items: center;
    gap: 0.6rem; justify-self: start;
    padding: 0.7rem 1.1rem; border-radius: var(--radius-pill);
    background: var(--card-accent-bg); color: #fff;
    box-shadow: var(--card-accent-shadow); text-decoration: none;
  }
  .wpr__cta-price {
    font-family: var(--font-display); font-weight: var(--fw-display); font-stretch: 112%;
    font-size: clamp(1.05rem, 2.6vw, 1.5rem); line-height: 1; letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .wpr__cta-label {
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase; white-space: nowrap;
  }
  .wpr__cta-icon { width: 1.1em; height: 1.1em; }
  @media (hover: hover) and (pointer: fine) {
    .wpr__cta { transition: transform var(--dur-base) var(--ease-out); }
    .wpr__cta:hover { transform: translateY(-2px); }
  }
</style>
