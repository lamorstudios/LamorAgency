---
/**
 * Problem → Lösung für die Website-Landingpage.
 * Links das, was Besucher an ihrer aktuellen Seite stört; rechts das Gegenstück.
 * Die Paare stehen in derselben Reihenfolge in src/data/website-pricing.ts.
 */
import Words from '@/components/Words.astro';
import { websiteProblems, websiteSolutions } from '@/data/website-pricing';

const pairs = websiteProblems.map((p, i) => ({ problem: p, solution: websiteSolutions[i] }));
---
<section class="wpr section" data-theme="light" data-bg="light" aria-labelledby="wpr-title">
  <div class="container">
    <div class="wpr__head">
      <p class="t-label wpr__label" data-reveal="fade">Ausgangslage</p>
      <h2 class="t-say wpr__title" id="wpr-title"><Words text="Deine Website sieht aus wie 2018?" /></h2>
      <p class="t-lead t-muted wpr__lead" data-reveal style="--reveal-delay:140ms">
        Das ist kein Schönheitsproblem. Eine Seite, die langsam lädt, auf dem Handy
        nicht funktioniert und keinen klaren Weg zur Anfrage hat, kostet dich Kunden –
        jeden Tag, ohne dass du es merkst.
      </p>
    </div>

    <ul class="wpr__list" role="list">
      {pairs.map((pair, i) => (
        <li class="wpr__row" data-reveal style={`--reveal-delay:${Math.min(i * 50, 320)}ms`}>
          <span class="wpr__problem">
            <span class="wpr__icon wpr__icon--bad" aria-hidden="true"></span>
            <span class="wpr__problem-text">{pair.problem}</span>
          </span>
          <span class="wpr__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
          </span>
          <span class="wpr__solution">
            <span class="wpr__icon wpr__icon--good" aria-hidden="true"></span>
            <span class="wpr__solution-text">{pair.solution}</span>
          </span>
        </li>
      ))}
    </ul>

    <p class="wpr__outro t-h3" data-reveal>Wir machen daraus einen digitalen Markenauftritt.</p>
  </div>
</section>

<style>
  .wpr__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-8); }
  .wpr__label { color: var(--c-accent); }
  .wpr__title { max-width: 18ch; }
  .wpr__lead { max-width: 56ch; }

  .wpr__list { display: grid; border-top: 1px solid var(--line); }
  .wpr__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .wpr__problem, .wpr__solution { display: flex; align-items: flex-start; gap: 0.7em; min-width: 0; }
  .wpr__problem-text { color: var(--fg-muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--fg-muted) 45%, transparent); }
  .wpr__solution-text { font-weight: var(--fw-semi); }

  .wpr__icon { width: 1.1rem; height: 1.1rem; margin-top: 0.25em; border-radius: 50%; flex-shrink: 0; position: relative; }
  .wpr__icon--bad { border: 1px solid var(--fg-muted); }
  .wpr__icon--bad::after { content: ''; position: absolute; inset: 45% 22%; border-top: 1px solid var(--fg-muted); }
  .wpr__icon--good { background: var(--c-accent); }
  .wpr__icon--good::after { content: ''; position: absolute; inset: 0; background: no-repeat center / 0.55rem url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M2 6.5L4.8 9L10 3' stroke='white' stroke-width='2' stroke-linecap='square'/></svg>"); }

  .wpr__arrow { display: none; width: 1rem; color: var(--fg-muted); align-self: center; }
  .wpr__arrow svg { width: 100%; height: auto; }

  @media (min-width: 768px) {
    .wpr__row { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-5); align-items: center; }
    .wpr__arrow { display: block; }
  }

  .wpr__outro { margin-top: var(--space-7); max-width: 24ch; }
</style>
