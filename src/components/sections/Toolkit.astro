---
/**
 * ============================================================================
 * WERKZEUG UND TECHNIK
 * ============================================================================
 *
 * Auf der bestehenden Website hiess dieser Abschnitt "Unsere Anbieter" und
 * war eine reine Logoreihe. Hier bekommt jedes Werkzeug eine Zeile dazu:
 * wofuer es da ist, in einem Satz, auch fuer Laien verstaendlich.
 *
 * WARUM DAS SO WICHTIG IST
 * Der Besucher soll das Gefuehl haben, er wird aufgeklaert – nicht beworben.
 * "Sony" allein sagt einem Restaurantbesitzer nichts. "Kameras und Objektive
 * fuer Film und Foto" schon. Genau dieser Unterschied entscheidet, ob jemand
 * Professionalitaet wahrnimmt oder nur Logos sieht.
 *
 * LOGOS: liegen sie in src/assets/brand/toolkit/<file>.svg|png, ersetzt das
 * Bild den Schriftzug. Ohne Logo steht der Name typografisch – gestaltet,
 * nicht kaputt. Es wird kein Logo nachgebaut und keine Marke ergaenzt.
 * Pflege: src/data/toolkit.ts
 */
import { Picture } from 'astro:assets';
import { toolkit, toolkitLead } from '@/data/toolkit';

const dateien = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/brand/toolkit/*.{svg,png,jpg,webp,avif}',
);

const werkzeuge = await Promise.all(
  toolkit.map(async (t) => {
    const treffer = Object.keys(dateien).find((p) =>
      p.includes(`/toolkit/${t.file}.`));
    return { ...t, img: treffer ? (await dateien[treffer]()).default : undefined };
  }),
);
---
<section class="tk" data-theme="dark" data-bg="dark" aria-labelledby="tk-title">
  <div class="container">
    <header class="tk__head">
      <p class="eyebrow tk__label" data-reveal="fade">Womit wir arbeiten</p>
      <h2 class="tk__title" id="tk-title" data-reveal>Technik, die man kennt.</h2>
      <p class="tk__lead" data-reveal style="--reveal-delay:140ms">{toolkitLead}</p>
    </header>

    <ul class="tk__grid" role="list">
      {werkzeuge.map((t, i) => (
        <li class="tk__item" data-reveal="fade" style={`--reveal-delay:${120 + i * 60}ms`}>
          <div class="tk__mark">
            {t.img
              ? <Picture src={t.img} formats={['webp']} widths={[180, 360]} sizes="150px" alt={t.name} class="tk__logo" loading="lazy" />
              : <span class="tk__name">{t.name}</span>}
          </div>
          <p class="tk__use">{t.use}</p>
          <p class="tk__kind">{t.kind}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tk { padding-block: clamp(2.5rem, 6vw, 5rem); }

  .tk__head { max-width: 42rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .tk__label { color: var(--c-accent-on-dark); }
  .tk__title {
    margin-top: var(--space-4);
    font-family: var(--font-display); font-weight: 900; font-stretch: 108%;
    font-size: clamp(1.75rem, 1rem + 3vw, 3.4rem);
    line-height: 1; letter-spacing: -0.035em; text-transform: uppercase;
  }
  .tk__lead { margin-top: var(--space-4); max-width: 46ch; color: var(--fg-muted); line-height: 1.55; }

  /* Spaltenzahl fest statt auto-fit: sechs Werkzeuge gehen durch 1, 2 und 3
     glatt auf. Bei auto-fit blieb auf breiten Schirmen eine halb leere Zeile
     stehen, deren Fugenfarbe dann wie ein Fehler aussah. */
  .tk__grid {
    display: grid; gap: 1px;
    grid-template-columns: 1fr;
    background: var(--c-ink-3);
    border: 1px solid var(--c-ink-3);
    border-radius: clamp(0.6rem, 1.5vw, 1rem);
    overflow: hidden;
  }
  @media (min-width: 30rem) { .tk__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 60rem) { .tk__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .tk__item {
    display: grid; align-content: start; gap: var(--space-3);
    padding: clamp(1.1rem, 2.6vw, 1.75rem);
    background: var(--c-ink);
  }

  .tk__mark { min-height: clamp(1.6rem, 3.5vw, 2.2rem); display: flex; align-items: center; }
  .tk__logo {
    width: auto; height: clamp(1.4rem, 3vw, 2rem); object-fit: contain;
    object-position: left center;
    /* Monochrom, damit sechs fremde Markenfarben die Seite nicht zerreissen. */
    filter: grayscale(1) brightness(1.7); opacity: 0.85;
  }
  .tk__name {
    font-family: var(--font-display); font-weight: 800; font-stretch: 104%;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.3rem);
    letter-spacing: -0.02em; text-transform: uppercase; color: var(--c-paper);
  }

  .tk__use { font-size: var(--fs-small); line-height: 1.5; color: var(--fg-muted); }
  .tk__kind {
    font-size: var(--fs-eyebrow); font-weight: var(--fw-semi); font-stretch: var(--wd-tight);
    letter-spacing: var(--ls-wide); text-transform: uppercase;
    color: var(--c-accent-on-dark);
  }
</style>
