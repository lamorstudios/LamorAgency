---
/**
 * Selected Clients – zwei gegenläufige Laufbänder in Plakatgrösse.
 *
 * Die obere Reihe läuft nach links und steht satt, die untere läuft nach
 * rechts und ist nur konturiert. Das Gegeneinander erzeugt Tiefe, ohne dass
 * eine zweite Farbe nötig wäre. Beim Hover füllt sich die Kontur.
 *
 * Logos: sobald in src/data/clients.ts ein `logo` hinterlegt ist, ersetzt das
 * Bild den Schriftzug. Ohne Logo ist der Name typografisch gesetzt – bewusst
 * gestaltet, kein Fehlzustand.
 */
import { Picture } from 'astro:assets';
import { clients } from '@/data/clients';

interface Props { title?: string; label?: string; theme?: 'dark' | 'light' }
const {
  title = 'Marken, die schon mit uns gearbeitet haben.',
  label = 'Selected Clients',
  theme = 'dark',
} = Astro.props;

const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brand/clients/*.{svg,png,jpg,webp,avif}');
const resolved = await Promise.all(
  clients.map(async (c) => ({ ...c, img: c.logo && logos[c.logo] ? (await logos[c.logo]()).default : undefined })),
);

// Zwei Reihen aus derselben Liste – versetzt, damit sich nichts spiegelt.
const half = Math.ceil(resolved.length / 2);
const rows = [resolved.slice(0, half), resolved.slice(half)];
---
<section class="cl" data-theme={theme} data-bg={theme} aria-labelledby="clients-title">
  <div class="container cl__head">
    <p class="t-label cl__label">{label}</p>
    <h2 class="cl__title" id="clients-title" data-reveal>{title}</h2>
    <p class="t-label cl__count" aria-hidden="true">{resolved.length} Marken</p>
  </div>

  {rows.map((row, ri) => (
    <div class={`marquee cl__band ${ri === 1 ? 'cl__band--outline marquee--reverse' : ''}`}
         style={`--marquee-speed:${ri === 0 ? 46 : 58}s`}>
      {[0, 1].map((copy) => (
        <ul class="marquee__row" role={ri === 0 && copy === 0 ? 'list' : 'presentation'} aria-hidden={copy === 1 ? 'true' : undefined}>
          {row.map((c) => (
            <li class="cl__item">
              {c.img ? (
                <Picture src={c.img} formats={['webp']} widths={[220, 440]} sizes="220px" alt={c.name} class="cl__logo" loading="lazy" />
              ) : (
                <span class="cl__name">{c.name}</span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</section>

<style>
  .cl { padding-block: var(--space-9) var(--space-8); overflow: clip; }

  .cl__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .cl__label { color: var(--c-accent-on-dark); }
  .cl__title {
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    font-stretch: 100%;
    font-size: clamp(1.3rem, 1rem + 1.4vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: var(--ls-snug);
    max-width: 24ch;
  }
  .cl__count { color: var(--fg-muted); }
  @media (min-width: 900px) {
    .cl__head { grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-7); }
    .cl__count { justify-self: end; }
  }

  /* ---------- Bänder ---------- */
  .cl__band { padding-block: clamp(0.4rem, 1.2vw, 0.9rem); }
  .cl__band + .cl__band { border-top: 1px solid var(--line); margin-top: clamp(0.4rem, 1.2vw, 0.9rem); }

  .cl__item { flex: none; display: grid; place-items: center; }

  .cl__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 0.8rem + 5.2vw, 5.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    white-space: nowrap;
    color: var(--fg);
    transition: color var(--dur-base) var(--ease-out);
  }
  /* Die zweite Reihe nur konturiert – Tiefe ohne zweite Farbe. */
  .cl__band--outline .cl__name {
    color: transparent;
    -webkit-text-stroke: 1px var(--fg-muted);
    text-stroke: 1px var(--fg-muted);
    transition: color var(--dur-base) var(--ease-out), -webkit-text-stroke-color var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .cl__item:hover .cl__name { color: var(--c-accent-on-dark); }
    .cl__band--outline .cl__item:hover .cl__name { color: var(--c-accent-on-dark); -webkit-text-stroke-color: transparent; }
  }

  .cl__logo {
    width: auto;
    height: clamp(1.75rem, 3.5vw, 3rem);
    object-fit: contain;
    opacity: 0.7;
    filter: grayscale(1);
    transition: opacity var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }
  .cl__item:hover .cl__logo { opacity: 1; filter: none; }
</style>
