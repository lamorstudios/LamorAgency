---
/**
 * Der USP-Bereich: alles läuft über ein Studio.
 * Die Kette Strategie → … → Website wird als durchgehende Linie gezeigt –
 * das ist der eigentliche Unterschied zu Agenturen, die zukaufen müssen.
 */
import Words from '@/components/Words.astro';
import Button from '@/components/Button.astro';
import { processSteps } from '@/data/process';

const phases = ['Denken', 'Produzieren', 'Ausspielen'] as const;
---
<section class="proc section" data-theme="dark" data-bg="dark" aria-labelledby="proc-title">
  <div class="container">
    <div class="proc__head">
      <p class="t-label proc__label" data-reveal="fade">Der Ablauf</p>
      <h2 class="t-display proc__title" id="proc-title">
        <Words lines={['One agency.', 'One look.', 'Every touchpoint.']} />
      </h2>
      <div class="proc__intro" data-reveal style="--reveal-delay:200ms">
        <p class="t-lead">Von der Idee bis zum fertigen Markenauftritt.</p>
        <p class="t-body t-muted">
          Strategie, Konzept, Talent, Produktion, Schnitt, Design, Social und Website
          laufen bei uns über denselben Tisch. Keine Übergabeverluste, keine drei
          Dienstleister, die sich gegenseitig erklären müssen – ein Look über alles.
        </p>
      </div>
    </div>

    <ol class="proc__chain" role="list">
      {processSteps.map((s, i) => (
        <li class="proc__step" data-reveal style={`--reveal-delay:${Math.min(i * 55, 440)}ms`}>
          <span class="proc__dot" aria-hidden="true"></span>
          <span class="proc__index t-label">{s.index}</span>
          <h3 class="proc__name t-h4">{s.title}</h3>
          <p class="proc__text t-small t-muted">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="proc__phases" aria-hidden="true">
      {phases.map((p) => <span class="proc__phase t-label">{p}</span>)}
    </div>

    <div class="proc__cta" data-reveal>
      <Button href="/contact/" label="Projekt anfragen" />
    </div>
  </div>
</section>

<style>
  .proc__head { display: grid; gap: var(--space-5); margin-bottom: var(--space-9); }
  .proc__label { color: var(--c-accent); }
  .proc__title { max-width: 14ch; }
  .proc__intro { display: grid; gap: var(--space-4); max-width: 56ch; }

  /* Mobile: senkrechte Kette mit durchgehender Linie. */
  .proc__chain { display: grid; gap: 0; position: relative; counter-reset: step; }
  .proc__step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'dot index' 'line name' 'line text';
    column-gap: var(--space-4);
    row-gap: 0.25rem;
    padding-bottom: var(--space-6);
  }
  .proc__step::before {
    content: '';
    grid-area: line;
    position: absolute;
    left: 0.3rem;
    top: 1.1rem;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .proc__step:last-child::before { display: none; }
  .proc__dot { grid-area: dot; width: 0.65rem; height: 0.65rem; margin-top: 0.45rem; border-radius: 50%; background: var(--c-accent); flex-shrink: 0; }
  .proc__index { grid-area: index; color: var(--fg-muted); }
  .proc__name { grid-area: name; }
  .proc__text { grid-area: text; max-width: 44ch; }

  .proc__phases { display: none; }

  /* Desktop: waagerechte Kette über drei Phasen. */
  @media (min-width: 900px) {
    .proc__chain {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-8);
      padding-top: var(--space-5);
    }
    .proc__step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'dot' 'index' 'name' 'text';
      row-gap: 0.5rem;
      padding-bottom: 0;
      padding-top: var(--space-5);
      border-top: 1px solid var(--line);
    }
    .proc__step::before { display: none; }
    .proc__dot { margin-top: 0; position: absolute; top: -0.32rem; left: 0; }
    .proc__phases {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
      margin-top: var(--space-8);
      padding-top: var(--space-5);
      border-top: 1px solid var(--line);
      color: var(--fg-muted);
    }
    .proc__phase:nth-child(2) { justify-self: center; }
    .proc__phase:nth-child(3) { justify-self: end; }
  }

  .proc__cta { margin-top: var(--space-8); }
</style>
