---
/**
 * Der USP-Bereich: alles laeuft ueber ein Studio.
 *
 * Komposition: keine Karten, sondern eine durchgehende waagerechte Leiste.
 * Ueber der Leiste liegen die drei Phasen als Spannen (Denken / Produzieren /
 * Ausspielen), darunter die zehn Schritte. Beides teilt dasselbe Raster, also
 * sitzt jede Phase exakt ueber ihren Schritten. Die Leiste scrollt waagerecht –
 * nativ, ohne Skript, damit sie auch ohne JS bedienbar bleibt.
 */
import Words from '@/components/Words.astro';
import Button from '@/components/Button.astro';
import { processSteps } from '@/data/process';

/** Phasen aus den Daten ableiten, damit die Spannen nie auseinanderlaufen. */
const phaseOrder = ['Denken', 'Produzieren', 'Ausspielen'] as const;
const phases = phaseOrder.map((name) => {
  const steps = processSteps.filter((s) => s.phase === name);
  return { name, span: steps.length, from: steps[0].index, to: steps[steps.length - 1].index };
});
---
<section class="proc" data-theme="dark" data-bg="dark" aria-labelledby="proc-title">
  <div class="container">
    <div class="proc__head">
      <div class="proc__headline">
        <p class="eyebrow proc__label" data-reveal="fade">Der Ablauf</p>
        <h2 class="proc__title" id="proc-title">
          <Words lines={['One agency.', 'One look.']} />
          <span class="proc__title-em t-serif-i">Every touchpoint.</span>
        </h2>
      </div>
      <div class="proc__intro" data-reveal style="--reveal-delay:160ms">
        <p class="proc__lead">Von der Idee bis zum fertigen Markenauftritt – zehn Schritte, ein Haus.</p>
        <p class="proc__body">
          Strategie, Konzept, Talent, Produktion, Schnitt, Design, Social und Website
          laufen bei uns über denselben Tisch. Keine Übergabeverluste, keine drei
          Dienstleister, die sich gegenseitig erklären müssen – ein Look über alles.
        </p>
        <div class="proc__cta"><Button href="/contact/" label="Projekt anfragen" /></div>
      </div>
    </div>

    <div class="proc__railwrap">
      <div class="proc__rail" tabindex="0" role="group" aria-label="Ablauf in zehn Schritten, waagerecht scrollbar">
        <div class="proc__track">
          <!-- Zeile 1: die Phasen als Spannen ueber ihren Schritten. -->
          {phases.map((p) => (
            <div class="proc__phase" style={`--span:${p.span}`}>
              <span class="proc__phase-name">{p.name}</span>
              <span class="proc__phase-range">{p.from}–{p.to}</span>
            </div>
          ))}

          <!-- Zeile 2: die zehn Schritte auf derselben Spur. -->
          {processSteps.map((s) => (
            <div class="proc__step">
              <span class="proc__dot" aria-hidden="true"></span>
              <span class="proc__index">{s.index}</span>
              <h3 class="proc__name">{s.title}</h3>
              <p class="proc__text">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
      <span class="proc__hint" aria-hidden="true">Leiste seitlich scrollen</span>
    </div>
  </div>
</section>

<style>
  .proc { padding-block: clamp(2.5rem, 6vw, 5rem); }

  .proc__head { display: grid; gap: var(--space-5); margin-bottom: clamp(1.75rem, 4vw, 3rem); }
  .proc__label { color: var(--c-accent-on-dark); }
  .proc__title {
    font-family: var(--font-display); font-weight: 900; font-stretch: 118%;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 0.6rem + 5vw, 5rem);
    line-height: 0.94; letter-spacing: -0.045em;
  }
  .proc__title-em { display: block; color: var(--c-accent-on-dark); text-transform: none; letter-spacing: -0.02em; }
  .proc__intro { display: grid; gap: var(--space-4); align-content: start; max-width: 58ch; }
  .proc__lead { font-size: var(--fs-lead); line-height: 1.35; }
  .proc__body { color: var(--fg-muted); font-size: var(--fs-small); line-height: 1.6; }
  .proc__cta { margin-top: var(--space-2); }

  @media (min-width: 900px) {
    .proc__head { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: var(--space-8); align-items: end; }
  }

  /* ---------- Die Leiste ---------- */
  .proc__railwrap { position: relative; }
  .proc__rail {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* Ohne das schnappt der erste Schritt an den Rand und frisst die Gasse. */
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: thin;
    /* Auf der vollen Breite ausbrechen, damit die Leiste den Rand beruehrt. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: var(--space-4);
  }
  .proc__rail:focus-visible { outline: 2px solid var(--c-accent-on-dark); outline-offset: 4px; }

  .proc__track {
    --col: clamp(11.5rem, 17vw, 14.5rem);
    display: grid;
    grid-template-columns: repeat(10, var(--col));
    grid-template-rows: auto auto;
    width: max-content;
  }

  .proc__phase {
    grid-row: 1;
    grid-column: span var(--span);
    display: flex; align-items: baseline; gap: var(--space-3);
    border-top: 2px solid var(--c-accent);
    padding: 0.55rem 1.25rem 1.1rem 0;
    font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide); text-transform: uppercase;
  }
  .proc__phase-name { font-weight: var(--fw-semi); font-stretch: var(--wd-tight); }
  .proc__phase-range { color: var(--fg-muted); font-variant-numeric: tabular-nums; }

  .proc__step {
    grid-row: 2;
    position: relative;
    scroll-snap-align: start;
    border-top: 1px solid var(--line);
    padding: 1.1rem 1.25rem 0 0;
    display: grid; gap: 0.35rem; align-content: start;
  }
  .proc__dot {
    position: absolute; top: -0.3rem; left: 0;
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--c-accent);
  }
  /* Nur der erste Schritt einer Phase bekommt den vollen Punkt. */
  .proc__step:not(:nth-child(4)):not(:nth-child(6)):not(:nth-child(11)) .proc__dot {
    background: var(--fg-muted); opacity: 0.5; width: 0.35rem; height: 0.35rem; top: -0.2rem;
  }
  .proc__index {
    font-family: var(--font-display); font-weight: var(--fw-display); font-stretch: 118%;
    font-size: 0.8rem; letter-spacing: var(--ls-wide); color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .proc__name {
    font-family: var(--font-display); font-weight: 900; font-stretch: 112%;
    text-transform: uppercase; font-size: clamp(1rem, 0.85rem + 0.5vw, 1.25rem);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .proc__text { font-size: 0.82rem; line-height: 1.5; color: var(--fg-muted); }

  .proc__hint {
    display: block; margin-top: var(--space-3);
    font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide);
    text-transform: uppercase; color: var(--fg-muted);
  }
  /* Ab der Breite, auf der die Leiste ohnehin fast vollstaendig sichtbar ist,
     braucht es den Hinweis nicht mehr. */
  @media (min-width: 1600px) { .proc__hint { display: none; } }
</style>
