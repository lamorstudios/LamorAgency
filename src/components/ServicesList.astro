---
/**
 * Leistungen als große typografische Liste. Desktop: Hover wechselt das Medium.
 * Mobile: Tippen öffnet Text und Medium. mode="full" zeigt alles offen.
 */
import Media from '@/components/Media.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import { services } from '@/data/services';
interface Props { mode?: 'compact' | 'full'; headingLevel?: 'h2' | 'h3' }
const { mode = 'compact', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class={`services services--${mode}`} data-services>
  <ul role="list" class="services__list">
    {services.map((s, i) => (
      <li class="services__item" id={mode === 'full' ? s.slug : undefined} data-service={i} data-reveal style={`--reveal-delay:${i * 30}ms`}>
        <button class="services__row" type="button" aria-expanded={mode === 'full' ? 'true' : 'false'} aria-controls={`svc-${mode}-${s.slug}`} data-service-toggle>
          <H class="services__title">{s.title}</H>
          <span class="services__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
          </span>
        </button>
        <div class="services__panel" id={`svc-${mode}-${s.slug}`} data-service-panel>
          <div class="services__panel-inner">
            <p class="t-body services__text">{s.short}</p>
            <p class="t-label t-muted services__taglist">{s.tags.join(' · ')}</p>
            {mode === 'compact' && <ArrowLink href={`/services/#${s.slug}`} label="Mehr" />}
            <div class="services__mobile-media">
              <Media media={s.media} surface={(i % 8) + 1} ratio="wide" sizes="100vw" />
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <div class="services__media" aria-hidden="true">
    <div class="services__media-sticky">
      {services.map((s, i) => (
        <div class={`services__media-item ${i === 0 ? 'is-active' : ''}`} data-service-media={i}>
          <Media media={s.media} surface={(i % 8) + 1} ratio="portrait" sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .services { display: grid; gap: var(--space-7); }
  .services__item + .services__item { border-top: 1px solid var(--line); }
  .services__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); width: 100%; text-align: left; padding-block: clamp(0.6rem, 2vw, 1.1rem); min-height: 48px; }
  .services__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 0.9rem + 4.6vw, 4.5rem);
    font-weight: var(--fw-display);
    font-stretch: var(--wd-mega);
    line-height: 0.96;
    letter-spacing: var(--ls-tight);
    text-transform: uppercase;
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .services__arrow { flex-shrink: 0; width: 1.15rem; height: 1.15rem; opacity: 0; transform: translateX(-0.5rem); transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out); color: var(--c-accent); }
  .services__arrow svg { width: 100%; height: 100%; }
  .services__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--dur-slow) var(--ease-expo); }
  .services__row[aria-expanded='true'] + .services__panel { grid-template-rows: 1fr; }
  .services__panel-inner { overflow: hidden; display: grid; gap: var(--space-4); }
  .services__row[aria-expanded='true'] + .services__panel .services__panel-inner { padding-bottom: var(--space-6); }
  .services__text { max-width: 46ch; }
  .services__media { display: none; }
  .services--full .services__arrow { display: none; }
  .services--full .services__panel { grid-template-rows: 1fr; }
  .services--full .services__panel-inner { padding-bottom: var(--space-6); }

  @media (hover: hover) {
    .services__row:hover .services__title, .services__row:focus-visible .services__title { transform: translateX(0.3em); color: var(--c-accent); }
    .services__row:hover .services__arrow, .services__row:focus-visible .services__arrow { opacity: 1; transform: translateX(0); }
  }

  @media (min-width: 900px) {
    .services { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-8); align-items: start; }
    .services__mobile-media { display: none; }
    .services__media { display: block; }
    .services__media-sticky { position: sticky; top: calc(var(--header-h) + var(--space-5)); }
    .services__media-item { position: absolute; inset: 0; opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
    .services__media-item:first-child { position: relative; }
    .services__media-item.is-active { opacity: 1; }
    .services__media-item :global(.media) { --ratio: 4 / 5; }
    .services__media-item :global(.media > *) { transform: scale(1.08); transition: transform 1.4s var(--ease-out); }
    .services__media-item.is-active :global(.media > *) { transform: scale(1); }
  }
</style>

<script>
  function initServices() {
    document.querySelectorAll<HTMLElement>('[data-services]').forEach((root) => {
      if ((root as any).__init) return; (root as any).__init = true;
      const items = root.querySelectorAll<HTMLElement>('[data-service]');
      const medias = root.querySelectorAll<HTMLElement>('[data-service-media]');
      const full = root.classList.contains('services--full');
      const activate = (i: number) => medias.forEach((m) => m.classList.toggle('is-active', m.dataset.serviceMedia === String(i)));
      items.forEach((item, i) => {
        const btn = item.querySelector<HTMLButtonElement>('[data-service-toggle]')!;
        item.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') activate(i); });
        btn.addEventListener('focus', () => activate(i));
        btn.addEventListener('click', () => {
          if (full) return;
          const open = btn.getAttribute('aria-expanded') === 'true';
          items.forEach((o) => o.querySelector('[data-service-toggle]')?.setAttribute('aria-expanded', 'false'));
          btn.setAttribute('aria-expanded', open ? 'false' : 'true');
          activate(i);
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initServices);
</script>
