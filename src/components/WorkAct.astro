---
import type { CollectionEntry } from 'astro:content';
import Media from '@/components/Media.astro';
/**
 * Ein Projekt als Auftritt, nicht als Karte.
 *
 * variant:
 *  feature – randlos über die volle Breite, Titel im Bild, Verlaufsschleier
 *  wide    – breites Medium, Titel schneidet die Oberkante an
 *  tall    – Hochformat, Beschriftung darunter
 *  square  – Quadrat, Beschriftung darunter
 *
 * Beschriftung bewusst knapp: laufende Nummer, Titel, Kategorie. Mehr braucht
 * ein Projekt an dieser Stelle nicht – das Bild soll arbeiten.
 */
interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  variant: 'feature' | 'wide' | 'tall' | 'square';
  priority?: boolean;
}
const { project, index, variant, priority = false } = Astro.props;
const d = project.data;
const href = `/work/${project.id}/`;
const hasHoverVideo = d.preview?.type === 'video' && d.preview.src;
const surface = (index % 8) + 1;
const num = String(index + 1).padStart(2, '0');
const ratio = variant === 'feature' ? 'cinema' : variant === 'wide' ? 'wide' : variant === 'tall' ? 'portrait' : 'square';
const sizes =
  variant === 'feature' || variant === 'wide' ? '100vw' : '(min-width: 900px) 46vw, 100vw';
---
<article class={`pc pc--${variant}`}>
  <a
    href={href}
    class="pc__link"
    data-cursor="View"
    data-hover-video={hasHoverVideo ? '' : undefined}
    aria-label={`${d.title} – ${d.client}, ${d.category}`}
  >
    <div class="pc__frame">
      <Media
        media={d.hero}
        surface={surface}
        ratio={ratio}
        hover
        reveal={variant !== 'feature'}
        priority={priority}
        sizes={sizes}
        widths={[560, 900, 1440, 1920]}
      />
      {hasHoverVideo && (
        <video class="pc__preview" src={d.preview!.src} muted loop playsinline preload="none" aria-hidden="true"></video>
      )}
      {variant === 'feature' && <span class="pc__scrim" aria-hidden="true"></span>}

      {variant === 'feature' && (
        <div class="pc__over container">
          <p class="pc__meta t-label"><span class="pc__num">{num}</span><span>{d.category}</span></p>
          <h3 class="pc__title pc__title--big">{d.title}</h3>
        </div>
      )}
    </div>

    {variant !== 'feature' && (
      <div class="pc__cap">
        <h3 class="pc__title">{d.title}</h3>
        <p class="pc__meta t-label"><span class="pc__num">{num}</span><span>{d.category}</span></p>
      </div>
    )}
  </a>
</article>

<style>
  .pc__link { display: block; }
  .pc__frame { position: relative; overflow: hidden; }

  .pc__preview {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0; z-index: 1;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) { .pc__link:hover .pc__preview { opacity: 1; } }

  /* ---------- Beschriftung ---------- */
  .pc__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    margin-top: var(--space-4);
  }
  .pc__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 110%;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 0.8rem + 1.8vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .pc__meta { display: inline-flex; align-items: baseline; gap: 0.8em; color: var(--fg-muted); white-space: nowrap; }
  .pc__num { color: var(--c-accent); }

  @media (hover: hover) and (pointer: fine) {
    .pc__link:hover .pc__title { transform: translateX(0.22em); }
    .pc__link:hover .pc__cap { border-color: var(--fg); }
  }

  /* ---------- feature: randlos, Titel im Bild ---------- */
  .pc--feature .pc__frame :global(.media) { --ratio: 4 / 5; }
  .pc__scrim {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(to top, rgba(11,10,9,0.85) 0%, rgba(11,10,9,0.25) 45%, transparent 72%);
  }
  .pc__over {
    position: absolute; inset: auto 0 0 0; z-index: 3;
    padding-bottom: clamp(1.25rem, 3.5vw, 3rem);
    color: var(--c-paper);
    display: grid;
    gap: var(--space-2);
  }
  .pc__over .pc__meta { color: rgba(242, 237, 228, 0.75); order: -1; }
  .pc__title--big {
    font-size: clamp(2rem, 0.8rem + 6.5vw, 7rem);
    font-stretch: 120%;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  /* ---------- wide: Titel schneidet die Oberkante an ---------- */
  .pc--wide .pc__cap {
    border-top: 0;
    border-bottom: 1px solid var(--line);
    margin-top: 0;
    margin-bottom: var(--space-4);
    padding-top: 0;
    padding-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .pc--feature .pc__frame :global(.media) { --ratio: var(--ratio-cinema); }
    /* Der Titel der breiten Variante ragt bewusst in das Bild hinein. */
    .pc--wide .pc__cap { position: relative; z-index: 3; margin-bottom: -0.5em; border: 0; padding-bottom: 0; }
    .pc--wide .pc__title { font-size: clamp(2.5rem, 1rem + 5vw, 5.5rem); font-stretch: 120%; letter-spacing: -0.045em; }
  }
</style>
