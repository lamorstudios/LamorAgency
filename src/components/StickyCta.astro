---
/**
 * Sticky-CTA – nur auf Seiten, die auf eine einzige Handlung hinarbeiten.
 *
 * Erscheint bewusst erst, wenn der Hero verlassen wurde (sonst steht er über
 * dem CTA, der ohnehin schon sichtbar ist), und verschwindet wieder, sobald
 * das Formular im Bild ist – dort wäre er nur im Weg.
 * Nur Mobile: ab 900px blendet CSS ihn aus.
 */
import { site } from '@/data/site';
interface Props { label?: string; href?: string; whatsapp?: boolean }
const { label = 'Website anfragen', href = '#anfrage', whatsapp = true } = Astro.props;
---
<div class="sticky-cta" data-sticky-cta hidden>
  <a href={href} class="btn sticky-cta__main">
    <span>{label}</span>
    <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  </a>
  {whatsapp && (
    <a href={site.whatsapp} class="sticky-cta__alt" target="_blank" rel="noopener noreferrer" aria-label="Per WhatsApp schreiben">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2A9.9 9.9 0 0 0 2.1 11.9c0 1.75.46 3.46 1.34 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01a9.9 9.9 0 0 0 9.9-9.9A9.9 9.9 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.22 8.22 0 1 1 6.97 3.86Zm4.5-6.15c-.25-.13-1.46-.72-1.69-.8-.22-.08-.39-.13-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.36-2.94c-.25-.44.25-.4.72-1.35.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3c-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.68 1.55.67 2.16.72 2.93.61.47-.07 1.46-.6 1.66-1.18.2-.57.2-1.06.15-1.17-.06-.1-.22-.17-.47-.29Z"/>
      </svg>
    </a>
  )}
</div>

<script>
  function initSticky() {
    const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
    if (!bar || (bar as any).__init) return;
    (bar as any).__init = true;
    if (!('IntersectionObserver' in window)) return;

    bar.hidden = false;
    const hero = document.querySelector('[data-bg]');
    const form = document.querySelector('#anfrage');
    let pastHero = false;
    let atForm = false;
    const sync = () => bar.classList.toggle('is-on', pastHero && !atForm);

    if (hero) {
      new IntersectionObserver(
        ([e]) => { pastHero = !e.isIntersecting; sync(); },
        { threshold: 0, rootMargin: '-120px 0px 0px 0px' },
      ).observe(hero);
    } else {
      pastHero = true;
    }
    if (form) {
      new IntersectionObserver(([e]) => { atForm = e.isIntersecting; sync(); }, { threshold: 0 }).observe(form);
    }
    sync();
  }
  document.addEventListener('astro:page-load', initSticky);
</script>
