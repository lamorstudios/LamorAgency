---
import { mainNav } from '@/data/navigation';
import { site, social } from '@/data/site';
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const path = norm(Astro.url.pathname);
const isActive = (href: string) => norm(href) === '/' ? path === '/' : path.startsWith(norm(href));
---
<header class="header" data-header transition:persist transition:name="header">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label={`${site.name} – Startseite`}>
      <span class="header__wordmark">{site.shortName}<sup>®</sup></span>
    </a>

    <nav class="header__nav" aria-label="Hauptnavigation">
      <ul role="list">
        {mainNav.map((item) => (
          <li><a href={item.href} class={`header__link link ${isActive(item.href) ? 'link--active' : ''}`} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/contact/" class="header__cta btn btn--ghost" data-magnetic>Let's talk</a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="nav-overlay" data-nav-toggle>
        <span class="visually-hidden">Menü</span>
        <span class="header__burger-line" aria-hidden="true"></span>
        <span class="header__burger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div id="nav-overlay" class="nav" data-nav aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menü">
  <div class="nav__inner container">
    <nav aria-label="Mobile Navigation">
      <ul role="list" class="nav__list">
        {mainNav.map((item, i) => (
          <li class="nav__item" style={`--i:${i}`}>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="nav__index t-label t-num">{item.index}</span>
              <span class="nav__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav__meta">
      <div class="nav__block" style="--i:6">
        <p class="t-label t-muted">Contact</p>
        <a href={`mailto:${site.email}`} class="nav__meta-link">{site.email}</a>
        <a href={site.phoneHref} class="nav__meta-link">{site.phone}</a>
      </div>
      <div class="nav__block" style="--i:7">
        <p class="t-label t-muted">Social</p>
        {social.map((s) => <a href={s.href} class="nav__meta-link" target="_blank" rel="noopener noreferrer">{s.label}</a>)}
      </div>
      <div class="nav__block nav__claim" style="--i:8">
        <p class="t-label">{site.claim}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-header);
    color: #fff; mix-blend-mode: difference;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .header.is-hidden { transform: translateY(-100%); }
  .header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-5);
    height: var(--header-h); padding-inline: var(--gutter);
    transition: height var(--dur-base) var(--ease-out);
  }
  .header.is-scrolled .header__inner { height: calc(var(--header-h) - 0.75rem); }
  .header__logo { display: inline-flex; align-items: center; min-height: 44px; }
  .header__wordmark { font-family: var(--font-display); font-weight: var(--fw-bold); letter-spacing: var(--ls-snug); font-size: 1.25rem; text-transform: uppercase; }
  .header__wordmark sup { font-size: 0.5em; vertical-align: top; margin-left: 0.1em; font-weight: var(--fw-regular); }
  .header__nav { display: none; }
  .header__nav ul { display: flex; gap: clamp(1.25rem, 2.5vw, 2.75rem); }
  .header__link { font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: var(--ls-wide); text-transform: uppercase; padding-block: 0.5rem; }
  .header__actions { display: flex; align-items: center; gap: var(--space-4); }
  .header__cta { display: none; --btn-fg: #fff; border-color: #fff; }
  .header__cta::before { background: #fff; }
  .header__cta:hover { color: #000; }
  .header__burger { position: relative; width: 44px; height: 44px; display: grid; place-items: center; gap: 6px; align-content: center; }
  .header__burger-line { display: block; width: 26px; height: 1.5px; background: currentColor; transition: transform var(--dur-base) var(--ease-out); transform-origin: center; }
  .header__burger[aria-expanded='true'] .header__burger-line:nth-child(2) { transform: translateY(3.75px) rotate(45deg); }
  .header__burger[aria-expanded='true'] .header__burger-line:nth-child(3) { transform: translateY(-3.75px) rotate(-45deg); }

  @media (min-width: 900px) {
    .header__nav { display: block; }
    .header__cta { display: inline-flex; }
    .header__burger { display: none; }
  }

  /* ---------- Fullscreen Overlay Navigation (Mobile) */
  .nav {
    position: fixed; inset: 0; z-index: var(--z-nav);
    background: var(--c-ink); color: var(--c-paper);
    visibility: hidden; clip-path: inset(0 0 100% 0);
    transition: clip-path var(--dur-slow) var(--ease-expo), visibility 0s linear var(--dur-slow);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .nav.is-open { visibility: visible; clip-path: inset(0 0 0 0); transition: clip-path var(--dur-slow) var(--ease-expo), visibility 0s; }
  .nav__inner { min-height: 100%; display: grid; align-content: space-between; gap: var(--space-8); padding-top: calc(var(--header-h) + var(--space-6)); padding-bottom: var(--space-7); }
  .nav__list { display: grid; }
  .nav__item { border-top: 1px solid var(--c-ink-3); }
  .nav__item:last-child { border-bottom: 1px solid var(--c-ink-3); }
  .nav__link { display: flex; align-items: baseline; gap: var(--space-4); padding-block: clamp(0.75rem, 2.5vw, 1.25rem); font-family: var(--font-display); font-size: clamp(2.5rem, 10vw, 5.5rem); line-height: 1; letter-spacing: var(--ls-tight); text-transform: uppercase; font-weight: var(--fw-medium); transition: color var(--dur-fast); }
  .nav__link[aria-current='page'], .nav__link:hover { color: var(--c-grey-dark); }
  .nav__index { color: var(--c-grey-dark); min-width: 2ch; }
  .nav__meta { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .nav__block { display: grid; gap: var(--space-2); align-content: start; }
  .nav__meta-link { font-size: var(--fs-body); min-height: 44px; display: inline-flex; align-items: center; }
  .nav__claim { align-self: end; }
  /* Stagger beim Öffnen */
  .nav__item, .nav__block { opacity: 0; transform: translateY(1.25rem); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-slow) var(--ease-out); }
  .nav.is-open .nav__item, .nav.is-open .nav__block { opacity: 1; transform: none; transition-delay: calc(140ms + var(--i, 0) * 55ms); }
  @media (min-width: 900px) { .nav { display: none; } }
  @media (prefers-reduced-motion: reduce) { .nav, .nav__item, .nav__block { transition: none; } }
</style>

<script>
  function initNav() {
    const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!btn || !nav || (btn as any).__init) return; (btn as any).__init = true;
    const focusables = () => Array.from(nav.querySelectorAll<HTMLElement>('a[href], button, [tabindex]:not([tabindex="-1"])'));
    const open = () => {
      nav.classList.add('is-open'); nav.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true'); document.body.classList.add('nav-open');
      setTimeout(() => focusables()[0]?.focus(), 200);
    };
    const close = (refocus = true) => {
      nav.classList.remove('is-open'); nav.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false'); document.body.classList.remove('nav-open');
      if (refocus) btn.focus();
    };
    btn.addEventListener('click', () => (nav.classList.contains('is-open') ? close() : open()));
    document.addEventListener('keydown', (e) => {
      if (!nav.classList.contains('is-open')) return;
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'Tab') {
        const f = focusables(); if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); (btn as HTMLElement).focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        else if (!e.shiftKey && document.activeElement === btn) { e.preventDefault(); first.focus(); }
      }
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) close(false); });
    document.addEventListener('astro:before-swap', () => close(false));
  }
  document.addEventListener('astro:page-load', initNav);
</script>
