---
interface Props { href: string; label: string; class?: string }
const { href, label, class: className = '' } = Astro.props;
---
<a href={href} class={`arrow-link ${className}`}>
  <span>{label}</span>
  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
</a>
