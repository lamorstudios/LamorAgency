---
import SectionLabel from '@/components/SectionLabel.astro';
import { clients } from '@/data/clients';
interface Props { index?: string; compact?: boolean }
const { compact = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brand/clients/*.{svg,png,jpg,webp}');
const resolved = await Promise.all(clients.map(async (c) => ({ ...c, img: c.logo && images[c.logo] ? (await images[c.logo]()).default : undefined })));
/* PLACEHOLDER: Namen laufen als Wortmarken-Wand, bis echte Logos in clients.ts stehen. */
const widths = [118, 92, 108, 76, 125, 100, 88, 115];
const weights = [800, 500, 700, 600, 800, 500, 700, 600];
---
<section class={`clients ${compact ? 'section--tight' : ''}`} aria-labelledby="clients-title">
  <div class="container">
    <SectionLabel label="Ausgewählte Kunden" />
    <h2 class="visually-hidden" id="clients-title">Ausgewählte Kunden</h2>
  </div>
  <div class="clients__marquee" data-reveal="fade">
    <div class="clients__track">
      {[...resolved, ...resolved].map((c, i) => (
        <span class="clients__item" aria-hidden={i >= resolved.length ? 'true' : undefined} data-placeholder={c.img ? undefined : 'CLIENT LOGO'}>
          {c.img
            ? <img src={c.img.src} width={c.img.width} height={c.img.height} alt={c.name} loading="lazy" decoding="async" />
            : <span class="clients__word" style={`font-stretch:${widths[i % 8]}%;font-weight:${weights[i % 8]}`}>{c.name}</span>}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .clients { padding-block: var(--space-8); }
  .clients__marquee { overflow: hidden; }
  .clients__track { display: flex; align-items: center; gap: clamp(2rem, 5vw, 5rem); width: max-content; animation: clients-marquee 55s linear infinite; }
  .clients__marquee:hover .clients__track { animation-play-state: paused; }
  .clients__item { display: inline-flex; align-items: center; opacity: 0.4; transition: opacity var(--dur-base), color var(--dur-base); }
  .clients__item:hover { opacity: 1; color: var(--c-accent); }
  .clients__word { font-family: var(--font-display); font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem); line-height: 1; letter-spacing: var(--ls-tight); text-transform: uppercase; white-space: nowrap; }
  .clients__item img { max-height: clamp(2.2rem, 4vw, 3.4rem); width: auto; object-fit: contain; filter: grayscale(1); }
  @keyframes clients-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .clients__track { animation: none; width: 100%; flex-wrap: wrap; padding-inline: var(--gutter); }
    .clients__item[aria-hidden='true'] { display: none; }
  }
</style>
